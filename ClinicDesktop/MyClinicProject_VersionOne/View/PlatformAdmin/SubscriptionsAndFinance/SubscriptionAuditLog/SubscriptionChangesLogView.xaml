<UserControl x:Class="MyClinicProject_VersionOne.View.PlatformAdmin.SubscriptionsAndFinance.SubscriptionAuditLog.SubscriptionChangesLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.SubscriptionsAndFinance.SubscriptionAuditLog"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
              FlowDirection="RightToLeft">
    <Border   Background="#FFB4D7FA" CornerRadius="2">


        <Grid Margin="5" >
            <Grid.RowDefinitions>

                <!-- العنوان والنص التوضيحي -->
                <RowDefinition Height="Auto"/>

                <!-- بطاقات الإحصائيات -->
                <RowDefinition Height="Auto"/>
                <!-- شريط البحث والفلترة -->
                <RowDefinition Height="Auto"/>
                <!-- جدول البيانات -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. العنوان والنص التوضيحي -->
            <!-- العنوان والوصف -->
            <Border Grid.Row="0" Style="{StaticResource MainBorderStyle}"
                            >
                <Grid >

                    <Grid.ColumnDefinitions>

                        <!-- الصورة -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- العنوان والوصف -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- صورة  -->

                    <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                  Style="{StaticResource ImageHeaderStyle}"/>


                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                               
                               >


                        <TextBlock Text="سجلات تغييرات حاله الاشتراك"
                                    Style="{StaticResource PrimaryTextTitleadd}"/>

                        <TextBlock   Text="مراجعه جميع التغييرات التي تمت على حاله اشتراكات المنشات في النظام مع تفاصيلها" 
                                      Style="{StaticResource SecondaryTextTitlePage}"/>


                    </StackPanel>

                </Grid>
            </Border>

            <!-- بطاقات الإحصائيات -->
            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!--البطاقه الاولى-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الثانيه-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الثالث-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الرابعه-->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--البطاقه الاولى وهي تجريبي-->
                    <Border  Grid.Column="0"      >
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="إجمالي التغيرات" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>


                    <!--البطاقه الثانيه-->
                    <Border  Grid.Column="1"     >
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="تفعيل الاشتراكات" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>

                    <!--البطاقه الثالثه-->
                    <Border  Grid.Column="2">
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="انها الاشتراكات" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>

                    <!--البطاقه الرابعه-->
                    <Border  Grid.Column="3">
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="ايقاف الاشتراكات" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>




                </Grid>

            </Border>

            <!-- 3. شريط البحث والفلترة (يتأقلم مع الشاشات الصغيرة) -->
            <Border Grid.Row="2" Style="{StaticResource MainBorderStyle}">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBox Grid.Column="0"  Margin="0,20,5,0"
                                 Style="{DynamicResource searchTextBoxStyle}"
                                 Tag="ابحث ب الاسم او برقم الهاتف"
                                 />



                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock Text="المنشاه/العياده" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox Grid.Column="0"  Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,5,0">
                                <ComboBoxItem Content="كل " />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                            <TextBlock Text="حاله الاشترام" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox Grid.Column="0"  Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,5,0">
                                <ComboBoxItem Content="كل " />
                            </ComboBox>
                        </StackPanel>

                       

                        <!--زر الفلتره-->
                        <Border Grid.Column="3" >
                            <StackPanel  VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="❶ من تاريخ-الي تاريخ" Style="{StaticResource FiledLabelStyle}" />
                                <Border BorderThickness="1" BorderBrush="#FFE9E5E5" Padding="5" Height="38" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker Grid.Column="0" BorderThickness="0"/>
                                        <DatePicker Grid.Column="1" BorderThickness="0"/>
                                    </Grid>

                                </Border>
                            </StackPanel>
                          
                        </Border>

                        <Button Grid.Column="4" Style="{StaticResource ButtonFilter}" />



                    </Grid>
                </StackPanel>
            </Border>


            <!--جدول البيانات الرئيسي-->
            <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}" >

                <DataGrid >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Width="50"/>
                        <DataGridTextColumn Header="المنشاة" Width="2*"/>
                       
                        <DataGridTextColumn Header="الحاله السابقه" Width="120"/>
                        <DataGridTextColumn Header="الحاله الجديدة" Width="120"/>
                        <DataGridTextColumn Header="سبب التغيير" Width="150"/>
                        <DataGridTextColumn Header="تاريخ العمليه" Width="110"/>
                        <DataGridTextColumn Header="المستخدم" Width="100"/>
                        <DataGridTextColumn Header="الاجراءات" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>






        </Grid>


    </Border>
</UserControl>
