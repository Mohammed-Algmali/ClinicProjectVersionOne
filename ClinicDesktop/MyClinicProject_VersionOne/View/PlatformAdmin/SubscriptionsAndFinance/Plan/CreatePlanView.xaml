
<Window x:Class="MyClinicProject_VersionOne.View.PlatformAdmin.SubscriptionsAndFinance.Plan.CreatePlanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.SubscriptionsAndFinance.Plan"
        mc:Ignorable="d"
        Title="CreatePlanView"  Width="800" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
           FlowDirection="RightToLeft">
    <Border   Background="#FFB4D7FA" CornerRadius="2">

        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
             
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Hidden"  Grid.Row="0">
                <StackPanel >
                    <!-- العنوان والوصف -->
                    <Border Style="{StaticResource MainBorderStyle}"
                            >
                        <Grid >

                            <Grid.ColumnDefinitions>

                                <!-- الصورة -->
                                <ColumnDefinition Width="Auto"/>

                                <!-- العنوان والوصف -->
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- صورة المستخدم -->

                            <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                 Style="{StaticResource ImageHeaderStyle}"/>


                            <!-- العنوان والوصف -->

                            <StackPanel Grid.Column="1"
                               
                               >

                                <TextBlock Text="إنشاء باقه جديده"
                                   Style="{StaticResource PrimaryTextTitleadd}"/>

                                <TextBlock Text="قم بادخال بيانات الباقه  الجديده في النظام"
                                   Style="{StaticResource SecondaryTextTitlePage}"/>

                            </StackPanel>

                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MainBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="❶ البيانات الأساسية" FontSize="16" FontWeight="Bold" Foreground="#0066FF" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0" Margin="5">
                                    <TextBlock Text="اسم الباقة *" Foreground="#333" Margin="0,0,0,5"/>
                                    <TextBox Height="38" Padding="5" VerticalContentAlignment="Center" Text="مثال: الباقة الأساسية" Foreground="Gray"/>
                                </StackPanel>


                                <StackPanel Grid.Column="1" Margin="5">
                                    <TextBlock Text="وصف الباقة *" Foreground="#333" Margin="0,0,0,5"/>
                                    <TextBox Height="80" Padding="5" TextWrapping="Wrap" AcceptsReturn="True" Text="أدخل وصفاً مختصراً عن الباقة ومميزاتها..."/>
                                    <TextBlock Text="0/500" FontSize="10" Foreground="Gray" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>


                                <StackPanel Grid.Column="2" Margin="5">
                                    <TextBlock Text="عدد الفروع المسموح بها *" Foreground="#333" Margin="0,0,0,5"/>
                                    <TextBox Height="38" Text="1" VerticalContentAlignment="Center" Padding="5"/>

                                    <TextBlock Text="حالة الباقة *" Foreground="#333" Margin="0,15,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Width="45" Height="22" IsChecked="True" Background="#10B981"/>
                                        <TextBlock Text="مفعلة" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>


                    <Border Style="{StaticResource MainBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="❷ أسعار الباقة" Style="{StaticResource CardHeaderStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="15" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="📅 السعر السنوي" FontWeight="Bold" Foreground="#0066FF" HorizontalAlignment="Right" Margin="0,0,0,10"/>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="المبلغ *" Style="{StaticResource FiledLabelStyle}"/>
                                                <TextBox Text="1,999.00" Style="{StaticResource TextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="العملة *" Style="{StaticResource FiledLabelStyle}"/>
                                                <ComboBox Height="35" SelectedIndex="0" Style="{StaticResource ModernComboBoxStyle}">
                                                    <ComboBoxItem Content="دولار أمريكي (USD)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="حالة السعر *" Margin="0,10,0,5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Width="40" Height="20" IsChecked="True"/>
                                            <TextBlock Text="مفعل" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>


                                <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="15" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="📅 السعر الشهري" FontWeight="Bold" Foreground="#0066FF" HorizontalAlignment="Right" Margin="0,0,0,10"/>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="المبلغ *" Style="{StaticResource FiledLabelStyle}"/>
                                                <TextBox Text="199.00" Style="{StaticResource TextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="العملة *" Style="{StaticResource FiledLabelStyle}"/>
                                                <ComboBox Height="35" SelectedIndex="0" Style="{StaticResource ModernComboBoxStyle}">
                                                    <ComboBoxItem Content="دولار أمريكي (USD)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="حالة السعر *" Margin="0,10,0,5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Width="40" Height="20" IsChecked="True"/>
                                            <TextBlock Text="مفعل" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MainBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="❸الوحدات والميزات المفعله" Style="{StaticResource CardHeaderStyle}"/>
                            <TextBlock Text="اختر المميزات التي ستتوفر في هذه الباقة" FontSize="11" Foreground="Gray" Margin="0,2,0,15"/>

                            <UniformGrid Columns="3" Rows="4">
                                <CheckBox Content="إدارة المواعيد"  Margin="5,8"/>
                                <CheckBox Content="إدارة المرضى"  Margin="5,8"/>
                                <CheckBox Content="إدارة المختبر"  Margin="5,8"/>

                                <CheckBox Content="السجلات الطبية"  Margin="5,8"/>
                                <CheckBox Content="الملفات الطبية"  Margin="5,8"/>
                                <CheckBox Content="التقارير المتقدمة"  Margin="5,8"/>

                                <CheckBox Content="الطوارئ" Margin="5,8"/>
                                <CheckBox Content="الوصفات الطبية"  Margin="5,8"/>
                                <CheckBox Content="الذكاء الاصطناعي"  Margin="5,8"/>

                                <CheckBox Content="التقارير المالية"  Margin="5,8"/>
                                <CheckBox Content="الإشعارات والتذكيرات"  Margin="5,8"/>
                                <CheckBox Content="الدعم الفني المميز"  Margin="5,8"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MainBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="📝 ملاحظات إضافية" Style="{StaticResource CardHeaderStyle}"/>
                            <TextBox Height="60" TextWrapping="Wrap" AcceptsReturn="True" Text="أدخل أي ملاحظات إضافية حول هذه الباقة   ..."/>
                            <TextBlock Text="0/500" FontSize="10" Foreground="Gray" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>


        </Grid>

    </Border>
</Window>
