<Window x:Class="MyClinicProject_VersionOne.View.PlatformAdmin.FacilitiesManagement.Facility.EditFacilityView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.FacilitiesManagement.Facility"
        mc:Ignorable="d"
        Title="EditFacilityView" Height="650" Width="800" FlowDirection="RightToLeft"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Border   Background="#FFB4D7FA" CornerRadius="2">
        <Grid>

            <Grid.RowDefinitions>


                <RowDefinition Height="80"/>
                <!-- عنوان الصفحة -->
                <RowDefinition Height="Auto"/>
                <!--البيانات الثابته-->
                <RowDefinition Height="Auto"/>
                <!-- معلومات المنشاه -->
                <RowDefinition Height="Auto"/>
                <!-- 3 - معلومات مدير المنشاه   -->
                <RowDefinition Height="Auto"/>
                <!-- 3 - معلومات مدير المنشاه  -->
                <RowDefinition Height="Auto"/>
                <!-- الأزرار -->

            </Grid.RowDefinitions>


            <!-- ========================================================= -->
            <!--                  1 - عنوان الصفحة                         -->
            <!-- ========================================================= -->


            <Border  Grid.Row="0"
                    Style="{StaticResource MainBorderStyle}">
                <Grid >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- الصورة -->
                        <ColumnDefinition Width="*"/>
                        <!-- العنوان والوصف -->
                    </Grid.ColumnDefinitions>


                    <!-- صورة المستخدم -->

                    <Image Grid.Column="0"
                       Source="/Styles/Images/user.png"
                           Style="{StaticResource ImageHeaderStyle}"
                       />


                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        >

                        <TextBlock Text="تعديل بيانات المنشاه"
                           Style="{StaticResource PrimaryTextTitleadd}"/>

                        <TextBlock Text="قم بتعديل البيانات  للمنشاة االموجوده في النظام"
                           Style="{StaticResource SecondaryTextTitlePage}"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!--البيانات الثابته-->
            <!-- ========================================================= -->
            <Border Grid.Row="1" Style="{StaticResource ReadOnlyInfoBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- العمود الأول: الملاحظة -->
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="📝 بيانات تعريفيه -غير قابله للتعديل" Style="{StaticResource FiledLabelStyle}"/>
                    </StackPanel>

                    <!-- العمود الثاني: رقم/كود المنشأة -->
                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="رقم المنشاه*" Style="{StaticResource FiledLabelStyle}"/>
                        <TextBox x:Name="txtFacliltyId"
                                 Text="{Binding FacilityCode}"
                                 IsReadOnly="True"
                                 Style="{DynamicResource searchTextBoxStyle}"/>
                    </StackPanel>

                    <!-- العمود الثالث: تاريخ الإنشاء -->
                    <StackPanel Grid.Column="2" Margin="0,0,5,0">
                        <TextBlock Text="تاربخ الانشاء*" Style="{StaticResource FiledLabelStyle}"/>
                        <TextBox x:Name="txtFacilityCreateAt"
                                 Text="{Binding CreatedAt}"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!--                   2 - معلومات المنشاة                     -->
            <!-- ========================================================= -->
            <Border Grid.Row="2" Style="{StaticResource MainBorderStyle}">
                <StackPanel>
                    <TextBlock Text="①  معلومات المنشاة" Style="{StaticResource CardHeaderStyle}"/>

                    <!-- الصف الأول -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- اسم المنشأة -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="اسم المنشاه *" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityName"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding FacilityName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>

                        <!-- رمز المنشأة -->
                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock Text="رمز المنشاء*" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityCode"
                                     IsReadOnly="True"
                                     Text="{Binding FacilityCode}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- نوع المنشأة -->
                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                            <TextBlock Text="نوع المنشاء *" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox x:Name="cmbFacilityTypes"
                                      ItemsSource="{Binding FacilityTypesList}"
                                      SelectedItem="{Binding SelectedFacilityType}"
                                      Style="{StaticResource ModernComboBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- الصف الثاني -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- رقم الترخيص -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="رقم ترخيص المنشاه*" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityLicenseNumber"
                                     Text="{Binding FacilityLicenseNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- تاريخ إصدار الترخيص -->
                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock Text="تاريخ اصدار المنشاه*" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityLicenseIssueDate"
                                     Text="{Binding LicenseIssueDate, StringFormat=yyyy/MM/dd, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- تاريخ انتهاء الترخيص -->
                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                            <TextBlock Text="تاريخ انتهاء الترخيص*" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityLicenseExpiryDate"
                                     Text="{Binding LicenseExpiryDate, StringFormat=yyyy/MM/dd, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!--                3 - الموقع و بيانات التواصل                -->
            <!-- ========================================================= -->
            <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}">
                <StackPanel>
                    <TextBlock Text="①  الموقع و بيانات التواصل" Style="{StaticResource CardHeaderStyle}"/>

                    <!-- الصف الأول -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- الدولة -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text=" الدوله*" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityCountry"
                                     Text="{Binding FacilityCountry, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- المحافظة/المدينة -->
                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock Text="المحافظه/المدينه *" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityCity"
                                     Text="{Binding FacilityCity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- العنوان التفصيلي -->
                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                            <TextBlock Text="العنوان-التفصيلي *" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityAddress"
                                     Text="{Binding FacilityAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- الصف الثاني -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- رقم الهاتف -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text=" رقم الهاتف *" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityPhone"
                                     Text="{Binding FacilityPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- البريد الإلكتروني -->
                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock Text="  البريد الالكتروني*" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityEmail"
                                     Text="{Binding FacilityEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- الموقع الإلكتروني -->
                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                            <TextBlock Text="الموقع الالكتروني *" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtFacilityWebsiteUrl"
                                     Text="{Binding FacilityWebSite, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>


            <!-- ========================================================= -->
            <!--                       4 - معلومات مدير المنشاه            -->
            <!-- ========================================================= -->
           


            <!-- ========================================================= -->
            <!--                       5 - الأزرار                          -->
            <!-- ========================================================= -->

            <Border Grid.Row="5" 
                Style="{StaticResource MainBorderStyle}">

                <StackPanel 
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight"
>
                    <!-- زر الإلغاء -->

                    <Button Style="{StaticResource ButtonExit}"
                            x:Name="btnCreateFacilityExit"
                            Command="{Binding SaveCommand}"
                             />


                    <!-- زر الحفظ تم تسميه كل مافي الواجهه -->

                    <Button Style="{StaticResource ButtonSave}"
                            x:Name="btnCreateFacilitSave"
                                 />


                </StackPanel>

            </Border>





        </Grid>
    </Border>
</Window>
