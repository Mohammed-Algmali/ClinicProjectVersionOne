<UserControl x:Class="MyClinicProject_VersionOne.View.PlatformAdmin.FacilitiesManagement.Facility.FacilityListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.FacilitiesManagement.Facility"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000"
              FlowDirection="RightToLeft"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition  Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">

                <Image Source="/Styles/Images/user.png"
                      Style="{StaticResource ImageHeaderStyle}"/>

                <StackPanel Orientation="Vertical"
                                 VerticalAlignment="Center">

                    <TextBlock Text="ادارة المنشآت"
                               Style="{StaticResource PrimaryTextTitleadd}"
                    />

                    <TextBlock Text="متابعه الحسابات الاداريه للمنشآت الطبيه المشتركه " 
                               Style="{StaticResource SecondaryTextTitlePage}"
                    />

                </StackPanel>
            </StackPanel>

            <!-- ============================================================
                     مربع البحث عن المستخدمين

                     Text:
                     ربط النص الذي يكتبه المستخدم بالخاصية SearchText
                     الموجودة داخل UserControllerViewModel.

                     UpdateSourceTrigger=PropertyChanged:
                     تحديث SearchText مباشرة مع كل حرف يتم كتابته،
                     حتى نستطيع تنفيذ البحث بشكل مباشر لاحقًا.
                     ============================================================ -->

            <TextBox Grid.Column="1"
                     Style="{DynamicResource searchTextBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="ابحث باسم المنشاه او رقم الهاتف"
            />




            <RadioButton  Grid.Column="2" x:Name="btnCreateFacility"
                             Style="{StaticResource ButtonADD}"
                             Content="اضافه منشاه" Checked="btnCreateFacility_Checked"
            />

        </Grid>

        <!-- ============================================================
             DataGrid المستخدمين

             ItemsSource:
             مصدر البيانات المعروضة في الجدول.

             SelectedItem:
             المستخدم الذي قام المستخدم بتحديده من الجدول.

             عند تحديد صف:
             يتم وضع المستخدم المحدد داخل
             UserControllerViewModel.SelectedUser
             ============================================================ -->

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Facilities}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <!-- رقم المنشأة -->
                <DataGridTextColumn Header="رقم المنشأة" 
                                    Binding="{Binding FacilityId}" 
                                    Width="90"/>

                <!-- اسم المنشأة -->
                <DataGridTextColumn Header="اسم المنشأة" 
                                    Binding="{Binding FacilityName}" 
                                    Width="180"/>

                <!-- المدير -->
                <DataGridTextColumn Header="المدير المسؤول" 
                                    Binding="{Binding ManagerFullName}" 
                                    Width="160"/>

                <!-- المحافظة -->
                <DataGridTextColumn Header="المحافظة" 
                                    Binding="{Binding FacilityCity}" 
                                    Width="120"/>

                <!-- العنوان -->
                <DataGridTextColumn Header="العنوان" 
                                    Binding="{Binding FacilityAddress}" 
                                    Width="*"/>

                <!-- الحالة -->
                <DataGridTextColumn Header="الحالة" 
                                    Binding="{Binding FacilityStatus}" 
                                    Width="90"/>

                <DataGridTemplateColumn Header="الإجراءات"
                        Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="تعديل"
                                 Width="60"
                                 Margin="2"
                                    Command="{Binding DataContext.EditFacilityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                     CommandParameter="{Binding FacilityId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            
        </DataGrid>
    </Grid>
</UserControl>