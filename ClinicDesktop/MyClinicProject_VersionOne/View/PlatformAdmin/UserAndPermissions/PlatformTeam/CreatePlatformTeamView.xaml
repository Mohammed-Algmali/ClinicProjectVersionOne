<Window x:Class="MyClinicProject_VersionOne.View.PlatformAdmin.UserAndPermissions.PlatformTeam.CreatePlatformTeamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.UserAndPermissions.PlatformTeam"
        mc:Ignorable="d"
        Title="CreatePlatformTeamView" Height="500" Width="800"
        Background="Transparent"
         WindowStartupLocation="CenterScreen"
        WindowStyle="None"
    FlowDirection="RightToLeft">
    
    <Border   Background="#FFB4D7FA" CornerRadius="2">
        <Grid>

            <Grid.RowDefinitions>

                <!-- عنوان الصفحة -->
                <RowDefinition Height="80"/>

                <!-- معلومات المستخدم -->
                <RowDefinition Height="*"/>


                <!-- الأزرار -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ========================================================= -->
            <!--                  1 - عنوان الصفحة                         -->
            <!-- ========================================================= -->


            <Border Grid.Row="0"
                    Style="{StaticResource MainBorderStyle}">
                <Grid >

                    <Grid.ColumnDefinitions>

                        <!-- الصورة -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- العنوان والوصف -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- صورة المستخدم -->

                    <Image Grid.Column="0"
                       Source="/Styles/Images/user.png"
                      Style="{StaticResource ImageHeaderStyle}"/>


                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                       >

                        <TextBlock Text="إنشاء عضو فريق جديد"
                           Style="{StaticResource PrimaryTextTitleadd}"/>

                        <TextBlock Text="قم بادخال بيانات عضو فريق المنصه الجديد في النظام"
                           Style="{StaticResource SecondaryTextTitlePage}"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ========================================================= -->
            <!--                 2 - معلومات المستخدم                      -->
            <!-- ========================================================= -->

            <Border Grid.Row="1"
                    Style="{StaticResource MainBorderStyle}"
                >

                <StackPanel>


                    <!-- عنوان القسم -->

                    <TextBlock Text="①  معلومات المستخدم"
                           Style="{StaticResource CardHeaderStyle}"/>


                    <!-- ================================================= -->
                    <!-- الصف الأول                                        -->
                    <!-- الاسم الكامل - اسم المستخدم - كلمة المرور         -->
                    <!-- ================================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- الاسم الكامل -->


                        <StackPanel Grid.Column="0"
                                    Margin="0,0,5,0"
                               >

                            <TextBlock Text="الاسم الكامل *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtFullName"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding User.FullName,UpdateSourceTrigger=PropertyChanged}"
                                 />

                        </StackPanel>



                        <!-- اسم المستخدم -->

                        <StackPanel Grid.Column="1"
                                Margin="0,0,5,0">

                            <TextBlock Text="اسم المستخدم *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtUsername"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding User.UserName,UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>


                        <!-- كلمة المرور -->

                        <StackPanel Grid.Column="2"
                                Margin="0,0,5,0">

                            <TextBlock Text="كلمة المرور *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtPassword"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding User.Password,UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>





                    </Grid>


                    <!-- ================================================= -->
                    <!-- الصف الثاني                                       -->
                    <!-- العنوان - الإيميل - رقم الهاتف                    -->
                    <!-- ================================================= -->

                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- العنوان -->

                        <StackPanel Grid.Column="0" Margin="0,0,5,0"
                                >

                            <TextBlock Text="العنوان *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtAddress"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding User.UserAddress,UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>


                        <!-- الإيميل -->

                        <StackPanel Grid.Column="1" Margin="0,0,5,0"
                                >

                            <TextBlock Text="الإيميل *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtEmail"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding User.UserEmail,UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>


                        <!-- رقم الهاتف -->

                        <StackPanel Grid.Column="2" Margin="0,0,5,0">


                            <TextBlock Text="رقم الهاتف *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtPhone"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding User.UserPhone,UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- الصف الثالث                                       -->
                    <!-- الجنس - تاريخ الميلاد - الصلاحيات                 -->
                    <!-- ================================================= -->

                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>


                        </Grid.ColumnDefinitions>



                        <!-- الصلاحيات -->

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">


                            <TextBlock Text="الصلاحيات *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <ComboBox x:Name="cmbPermissions"
                                ItemsSource="{Binding Roles}"
                                DisplayMemberPath="RoleName"
                                SelectedValuePath="RoleId"
                                SelectedValue="{Binding User.RoleId,
                                  UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernComboBoxStyle}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            

                            <TextBlock Text="ملاحضه*"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox 
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding User.UserPhone,UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>


                    </Grid>


                </StackPanel>

            </Border>




            <Border Grid.Row="2" Style="{StaticResource MainBorderStyle}">

                <StackPanel 
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight"
>
                    <!-- زر الإلغاء -->

                    <Button Style="{StaticResource ButtonExit}"
                            x:Name="btnCreatePlatformTeamExit" 
                            Click="btnCreatePlatformTeamExit_Click"
                             />


                    <!-- زر الحفظ تم تسميه كل مافي الواجهه -->

                    <Button Style="{StaticResource ButtonSave}"
                            x:Name="btnCreatePlatformTeamSave"
                                 />


                </StackPanel>

            </Border>


            <!-- ========================================================= -->
            <!--                       3 - الأزرار                          -->
            <!-- ========================================================= -->



        </Grid>
    </Border>
</Window>
