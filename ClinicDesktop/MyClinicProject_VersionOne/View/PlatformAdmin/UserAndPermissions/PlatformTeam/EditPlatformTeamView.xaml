<Window x:Class="MyClinicProject_VersionOne.View.PlatformAdmin.UserAndPermissions.PlatformTeam.EditPlatformTeamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.UserAndPermissions.PlatformTeam"
        xmlns:helpers="clr-namespace:MyClinicProject_VersionOne.Helpers"
        mc:Ignorable="d"
        Title="EditPlatformTeamView"  Height="550" Width="900"
        Background="Transparent"
         WindowStartupLocation="CenterScreen"
        WindowStyle="None"
    FlowDirection="RightToLeft">

    <Border   Background="#FFB4D7FA" CornerRadius="2">
        <Grid>

            <Grid.RowDefinitions>

                <!-- عنوان الصفحة -->
                <RowDefinition Height="80"/>

                <RowDefinition Height="Auto"/>

                <!-- معلومات المستخدم -->
                <RowDefinition Height="*"/>


                <!-- الأزرار -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ========================================================= -->
            <!--                  1 - عنوان الصفحة                         -->
            <!-- ========================================================= -->


            <Border Grid.Row="0"
                    Style="{StaticResource MainBorderStyle}">
                <Grid >

                    <Grid.ColumnDefinitions>

                        <!-- الصورة -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- العنوان والوصف -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- صورة المستخدم -->

                    <Image Grid.Column="0"
                       Source="/Styles/Images/user.png"
                      Style="{StaticResource ImageHeaderStyle}"/>


                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                       >

                        <TextBlock Text="تعديل عضو فريق"
                           Style="{StaticResource PrimaryTextTitleadd}"/>

                        <TextBlock Text="قم بتعديل بيانات عضو فريق المنصه الموحود في النظام"
                           Style="{StaticResource SecondaryTextTitlePage}"/>

                    </StackPanel>

                </Grid>

            </Border>
            
            
            <!-- ========================================================= -->
            <!--البيانات الثابته-->
            <!-- ========================================================= -->

            <Border  Grid.Row="1" Style="{StaticResource ReadOnlyInfoBorderStyle}">

                <Grid  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!--العمود االاول الذي يةجد به الملاحظه-->
                        <ColumnDefinition Width="*"/>
                        <!--العمود الثاني الذي يحنوي علي رقم المستخدم -->
                        <ColumnDefinition Width="*"/>
                        <!--العمود الثالث والذي يحتوي علي تاريخ الانشاء -->
                    </Grid.ColumnDefinitions>

                    <!--العمود االاول الذي يةجد به الملاحظه-->
                    <StackPanel Grid.Column="0" Margin="0,0,5,0" >
                        <TextBlock Text="📝 بيانات تعريفيه -غير قابله للتعديل" Style="{StaticResource FiledLabelStyle}"/>
                    </StackPanel>


                    <!--العمود الثاني الذي يحنوي علي رقم المستخدم -->
                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="رقم المستخدم*" Style="{StaticResource FiledLabelStyle}"/>
                        <TextBox  
                                     x:Name="txtUserId" Text="DGN-000148" Style="{DynamicResource TextBoxStyle}"/>

                    </StackPanel>

                    <!--العمود الثالث والذي يحتوي علي تاريخ الانشاء -->
                    <StackPanel Grid.Column="2" Margin="0,0,5,0">
                        <TextBlock Text="تاربخ الانشاء*"  Style="{StaticResource FiledLabelStyle}"/>
                        <TextBox x:Name="txtUserCreateAt"  Text="2026/02/02" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>


                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!--                 2 - معلومات المستخدم                      -->
            <!-- ========================================================= -->

            <Border Grid.Row="2"
                    Style="{StaticResource MainBorderStyle}"
                >

                <StackPanel>


                    <!-- عنوان القسم -->

                    <TextBlock Text="①  معلومات المستخدم"
                           Style="{StaticResource CardHeaderStyle}"/>


                    <!-- ================================================= -->
                    <!-- الصف الأول                                        -->
                    <!-- الاسم الكامل - اسم المستخدم - كلمة المرور         -->
                    <!-- ================================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- الاسم الكامل -->


                        <StackPanel Grid.Column="0"
                                    Margin="0,0,5,0"
                               >

                            <TextBlock Text="الاسم الكامل *"
                                   Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="TxtName"
                 Style="{StaticResource TextBoxStyle}"
                 helpers:InputHelper.IsTextOnly="True"
                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <!-- نص رسالة الخطأ الخاص بالاسم -->
                            <TextBlock Text="{Binding ElementName=TxtName, Path=(Validation.Errors)/ErrorContent}"
                   Foreground="#DC2626" FontSize="11" />

                        </StackPanel>



                        <!-- اسم المستخدم -->

                        <StackPanel Grid.Column="1"
                                Margin="0,0,5,0">

                            <TextBlock Text="اسم المستخدم" Style="{StaticResource FiledLabelStyle}" />

                            <TextBox x:Name="TxtUsername"
                                 Style="{StaticResource TextBoxStyle}"
                                 helpers:InputHelper.IsUsernameOnly="True"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <TextBlock Text="{Binding ElementName=TxtUsername,Path=(Validation.Errors)/ErrorContent}"
                                    Foreground="#DC2626" FontSize="11" Margin="0,3,0,15"/>
                        </StackPanel>


                        <!-- كلمة المرور -->

                        <StackPanel Grid.Column="2"
                                Margin="0,0,5,0">

                            <TextBlock Text="كلمة المرور *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <PasswordBox x:Name="PbPassword"
                                 Style="{StaticResource PasswordBoxStyle}"
                                 helpers:PasswordHelper.Attach="True"
                                 helpers:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <!-- نص رسالة الخطأ الخاص بكلمة المرور -->
                            <TextBlock Text="{Binding ElementName=PbPassword, Path=(Validation.Errors)/ErrorContent}"
                                 Foreground="#DC2626" FontSize="11" Margin="0,3,0,15"/>
                        </StackPanel>





                    </Grid>


                    <!-- ================================================= -->
                    <!-- الصف الثاني                                       -->
                    <!-- العنوان - الإيميل - رقم الهاتف                    -->
                    <!-- ================================================= -->

                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- العنوان -->

                        <StackPanel Grid.Column="0" Margin="0,0,5,0"
                                >

                            <TextBlock Text="العنوان *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtAddress"
                                 Style="{StaticResource TextBoxStyle}"
                                 helpers:InputHelper.IsAddressOnly="True"
                                 Text="{Binding Address,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Text="{Binding ElementName=txtAddress, Path=(Validation.Errors)/ErrorContent}"
                                       Foreground="Crimson"
                                       FontSize="12"
                                        />
                        </StackPanel>


                        <!-- الإيميل -->

                        <StackPanel Grid.Column="1" Margin="0,0,5,0"
                                >

                            <TextBlock Text="الإيميل *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtEmail"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding Email,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <TextBlock Text="{Binding ElementName=txtEmail, Path=(Validation.Errors)/ErrorContent}"
                                       Foreground="Crimson"
                                       FontSize="12"
                                        />
                        </StackPanel>


                        <!-- رقم الهاتف -->

                        <StackPanel Grid.Column="2" Margin="0,0,5,0">


                            <TextBlock Text="رقم الهاتف *"
                                   Style="{StaticResource FiledLabelStyle}"/>




                            <TextBox x:Name="TxtPhone"
                                 Style="{StaticResource TextBoxStyle}"
                                 helpers:InputHelper.IsPhoneOnly="True"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <!-- هذا النص يقرأ رسالة الخطأ من الحقل أعلاه ويعرضها باللون الأحمر -->
                            <TextBlock Text="{Binding ElementName=TxtPhone, Path=(Validation.Errors)/ErrorContent}"
                                       Foreground="Crimson"
                                       FontSize="12"
                                        />

                        </StackPanel>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- الصف الثالث                                       -->
                    <!-- الجنس - تاريخ الميلاد - الصلاحيات                 -->
                    <!-- ================================================= -->

                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>


                        </Grid.ColumnDefinitions>



                        <!-- الصلاحيات -->

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">


                            <TextBlock Text="الصلاحيات *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <ComboBox x:Name="cmbPermissions"
                                ItemsSource="{Binding Roles}"
                                DisplayMemberPath="RoleName"
                                SelectedValuePath="RoleId"
                                SelectedValue="{Binding User.RoleId,
                                  UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Content="Admin" IsSelected="True"/>
                                <ComboBoxItem Content="ClinicManager" />
                                
                            </ComboBox>

                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,5,0">


                            <TextBlock Text="ملاحضه*"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox 
                                 Style="{StaticResource TextBoxStyle}"
                               
                                 Text="{Binding User.UserPhone,UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>


                    </Grid>


                </StackPanel>

            </Border>




            <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}">

                <StackPanel 
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight"
>
                    <!-- زر الإلغاء -->

                    <Button Style="{StaticResource ButtonExit}"
                            x:Name="btnEditPlatformTeamExit" Click="btnEditPlatformTeamExit_Click"
                             />


                    <!-- زر الحفظ تم تسميه كل مافي الواجهه -->

                    <Button Style="{StaticResource ButtonSave}"
                            x:Name="btnEditPlatformTeamSave"
                                 />


                </StackPanel>

            </Border>


            <!-- ========================================================= -->
            <!--                       3 - الأزرار                          -->
            <!-- ========================================================= -->



        </Grid>
    </Border>
</Window>