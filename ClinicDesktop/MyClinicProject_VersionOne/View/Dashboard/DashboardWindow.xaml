<Window x:Class="MyClinicProject_VersionOne.View.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sidebar="clr-namespace:MyClinicProject_VersionOne.View.Sidebar"
        mc:Ignorable="d"
        Title="DashboardWindow" 
        Height="700" Width="1200"
         FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="#d3d5da" CornerRadius="10,10,10,10"  >
        <Grid >
            <Grid.ColumnDefinitions>
                <!--القائمه الجانبيه-->
                <ColumnDefinition Width="280"/>
                <!--content-->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        
            
            <!--القائمه الجانبيه-->
            <sidebar:Sidebar   Grid.Column="0"/>


            <Border Grid.Column="1"
                   >

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!--Control Button-->


                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="25" />
                            <!--Button Minimized window-->
                            <ColumnDefinition Width="25"/>
                            <!--Button Close window-->
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="5"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MinimizeButton"
                                     Click="MinimizeButton_Click"
                                     Grid.Column="1"
                                     Background="#28AEEd"
                                     Style="{StaticResource windowControlButton}"/>

                        <Button x:Name="MaximizeButton"
                                     Click="MaximizeButton_Click"
                                     Grid.Column="2"
                                     Background="#DA34AE"
                                     Style="{StaticResource windowControlButton}"/>

                        <!--Button Close winndow-->
                        <Button x:Name="CloseButton"
                                     Click="CloseButton_Click"
                                     Grid.Column="3"
                                     Background="red"
                                     Style="{StaticResource windowControlButton}"/>


                    </Grid>

                    <Border Grid.Row="1"
                            Background="White"
                            Margin="2">
                        <StackPanel Orientation="Horizontal" 
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight">

                            <Ellipse Height="40" Width="40"
                                         Margin="10,0,0,0">
                                <Ellipse.Fill >
                                    <ImageBrush ImageSource="/Styles/Images/background_log.png"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="علياء محمد"
                                           FontSize="12"
                                           Margin="5,7,5,0"
                                           Foreground="Black"
                                           FontWeight="Medium"
                                           FontFamily="{StaticResource CairFont}"/>

                                <TextBlock     Text="مدير النظام"
                                               FontSize="10"
                                               Margin="5,7,5,0"
                                               Foreground="Gray"
                                               FontWeight="Medium"
                                               FontFamily="{StaticResource CairFont}"/>
                            </StackPanel>

                            <Image Source="/Styles/Images/messaging1.png"
                                   Height="30"/>


                        </StackPanel>
                    </Border>

                    <ContentControl x:Name="MainControllArea"
                                    Grid.Row="2"
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{Binding CurrentView}"
                                    >
                      
                    </ContentControl>


                </Grid>

            </Border>
        </Grid>
    </Border>
</Window>
