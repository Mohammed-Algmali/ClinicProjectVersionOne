<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.OperationAudit.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.OperationAudit"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
              FlowDirection="RightToLeft">
    <Border   Background="#FFB4D7FA" CornerRadius="2">


        <Grid Margin="5" >
            <Grid.RowDefinitions>

                <!-- العنوان والنص التوضيحي -->
                <RowDefinition Height="Auto"/>

                <!-- بطاقات الإحصائيات -->
                <RowDefinition Height="Auto"/>
                <!-- شريط البحث والفلترة -->
                <RowDefinition Height="Auto"/>
                <!-- جدول البيانات -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. العنوان والنص التوضيحي -->
            <!-- العنوان والوصف -->
            <Border Grid.Row="0" Style="{StaticResource MainBorderStyle}"
                            >
                <Grid >

                    <Grid.ColumnDefinitions>

                        <!-- الصورة -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- العنوان والوصف -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- صورة  -->

                    <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                   Width="42"
                                   Height="42"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>


                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">


                        <TextBlock Text="سجلات التدقيق"
                                    Style="{StaticResource PrimaryTextTitleadd}"/>

                        <TextBlock   Text="مراجعه وتتبع الوصول والتغييرات على بيانات النظام" 
                                      Style="{StaticResource SecondaryTextTitlePage}"/>


                    </StackPanel>

                </Grid>
            </Border>

            <!-- بطاقات الإحصائيات -->
            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!--البطاقه الاولى-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الثانيه-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الثالث-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الرابعه-->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--البطاقه الاولى وهي تجريبي-->
                    <Border  Grid.Column="0"      >
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="إجمالي الاحداث" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>


                    <!--البطاقه الثانيه-->
                    <Border  Grid.Column="1"     >
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="تعديلات" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>

                    <!--البطاقه الثالثه-->
                    <Border  Grid.Column="2">
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="محاولات دخول" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>

                    <!--البطاقه الرابعه-->
                    <Border  Grid.Column="3">
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="احداث تحتاج مراجعه" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>




                </Grid>

            </Border>

            <!-- 3. شريط البحث والفلترة (يتأقلم مع الشاشات الصغيرة) -->
            <Border Grid.Row="2" Style="{StaticResource MainBorderStyle}">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="الفتره الزمنيه" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox Grid.Column="0"  Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,5,0">
                                <ComboBoxItem Content="كل " />
                            </ComboBox> 
                        </StackPanel>



                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock Text="المستخدمين/الادوار" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox Grid.Column="0"  Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,5,0">
                                <ComboBoxItem Content="كل " />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                            <TextBlock Text="نوع العمليه" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox Grid.Column="0"  Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,5,0">
                                <ComboBoxItem Content="كل " />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,5,0">
                            <TextBlock Text="الوحده/الكيان" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox Grid.Column="0"  Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,5,0">
                                <ComboBoxItem Content="كل " />
                            </ComboBox>
                        </StackPanel>

                        <!--زر الفلتره-->
                        
                        <Button Grid.Column="4" Style="{StaticResource ButtonFilter}" />
                        
                       

                    </Grid>
                </StackPanel>
            </Border>

            
                <!--جدول البيانات الرئيسي-->
            <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}" >

                    <DataGrid >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="50"/>
                            <DataGridTextColumn Header="اسم المستخدم/الدور" Width="2*"/>
                            <DataGridTextColumn Header="الحدث/العمليه" Width="1.5*"/>
                            <DataGridTextColumn Header="اسم الجدول" Width="1.5*"/>
                            <DataGridTextColumn Header="القيمه القديمه" Width="120"/>
                            <DataGridTextColumn Header="القيمه الجديد" Width="2*"/>
                            <DataGridTextColumn Header="رقم السجل" Width="90"/>
                            <DataGridTextColumn Header="تاريخ العمليه" Width="110"/>
                            <DataGridTextColumn Header="الحاله" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
            </Border>

            




        </Grid>


    </Border>
</UserControl>

