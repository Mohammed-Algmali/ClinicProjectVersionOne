<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.PatientAndAppointments.MedicalRecords.Allergy.AllergiesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.PatientAndAppointments.MedicalRecords.Allergy"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
           FlowDirection="RightToLeft">

    <Border   Background="#FFB4D7FA" CornerRadius="2">


        <Grid Margin="5" >
            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>
                <!--شريط العنوان للحساسية المسجلة وزر الاضافة-->
                <RowDefinition Height="170"/>
                <!-- شرط العنواين التي تحتوي اخر مراجعة مع الملاحاظات -->
            </Grid.RowDefinitions>

            <!--بطاقه معلومات الحساسية وزر الاضافة -->
            <Border Grid.Row="0"  Style="{StaticResource MainBorderStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- شريط الحساسية مع زر الاضافة -->
                        <RowDefinition Height="Auto"/>
                        <!-- الجدول الذي سوف يعرض البيانات للمريض  -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="الحساسيات المسجلة" Style="{StaticResource CardHeaderStyle}"/>
                        <RadioButton Grid.Column="1" Content="إضافة حساسية" Style="{StaticResource ButtonADD}" />



                    </Grid>


                    <!-- 4. جدول البيانات (يدعم التمرير الأفقي عند انخفاض المساحة) -->
                    <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}" >

                        <DataGrid >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="50"/>
                                <DataGridTextColumn Header="المادة المسببة " Width="2*"/>
                                <DataGridTextColumn Header="نوع الحساسية" Width="1.5*"/>
                                <DataGridTextColumn Header="التفاعل" Width="1.5*"/>
                                <DataGridTextColumn Header="الشدة " Width="120"/>
                                <DataGridTextColumn Header="تاريخ التسجيل " Width="2*"/>
                                <DataGridTextColumn Header="الحالة" Width="90"/>
                                <DataGridTextColumn Header="الإجراءات" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Border>


                </Grid>

            </Border>

            <!--بطاقه معلومات  المراجعات و الملاحظات-->
            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">


                <Grid >
                    <Grid.ColumnDefinitions>
                        <!--شريط الحساسية مع زر الاضافة -->
                        <ColumnDefinition Width="*"/>
                        <!-- شريط البيانات الجدولية -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اخر مراجعة ملاحظة يجب عمل تنسيق  لتغيير تنسيق البطائق" Style="{StaticResource CardHeaderStyle}"/>

                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" >
                                <HeaderedContentControl Grid.Column="0" Style="{StaticResource InfoCardStyle}"
                            Header="تاريخ المراجعة " 
                            Content="22/12/2026"
                            Tag="👥"/>

                            </Border>



                            <HeaderedContentControl Grid.Column="1" Style="{StaticResource InfoCardStyle}"
                            Header="مراجعة بواسطة" 
                            Content=" د.سارة علي "
                            Tag="👥"/>




                        </Grid>
                    </StackPanel>



                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Text="📝 ملاحظات إضافية" FontSize="14" FontWeight="Bold" Foreground="#0066FF" Margin="0,0,0,10"/>
                        <TextBox Height="60" TextWrapping="Wrap" AcceptsReturn="True" />
                    </StackPanel>

                </Grid>

            </Border>





        </Grid>


    </Border>
</UserControl>