<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.PatientAndAppointments.MedicalRecords.MedicalRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.PatientAndAppointments.MedicalRecords"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
               FlowDirection="RightToLeft">
    <Border   Background="#FFB4D7FA" CornerRadius="2">


        <Grid Margin="5" >
            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/> <!--شريط العنوان الرئيسي-->
                <RowDefinition Height="120"/><!--بطاقه معلومات المريض-->
                <RowDefinition Height="Auto"/><!--شريط التبويبات -->
                <RowDefinition Height="Auto"/><!--شريط التخذير للتنبيهات-->
                <RowDefinition Height="*"/><!--المحتوى الرئيسي-->
            </Grid.RowDefinitions>

            <!-- 1. شريط العنوان الرئيسي -->
            <Border Grid.Row="0" Style="{StaticResource MainBorderStyle}"
                            >
                <Grid >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><!-- الصورة -->
                        <ColumnDefinition Width="*"/> <!-- العنوان والوصف -->
                    </Grid.ColumnDefinitions>


                    <!-- صورة المستخدم -->

                    <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                   Width="42"
                                   Height="42"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    
                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        
                        <TextBlock Text="الملف الطبي الالكتروني"
                                    Style="{StaticResource PrimaryTextTitleadd}"/>

                    </StackPanel>

                </Grid>
            </Border>
            
            <!--بطاقه معلومات المريض-->
            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- اسم المريض ورقم الملف -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" >
                        <Border Width="40" Height="40" Background="#E2E8F0" CornerRadius="20" Margin="0,0,10,0">
                            <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="أحمد محمد علي" FontWeight="Bold" FontSize="16" Foreground="#1E293B" />
                            <TextBlock Text="رقم الملف: 100458" Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- الجنس -->
                    <HeaderedContentControl Grid.Column="1" Header="الجنس" Content="ذكر" Style="{StaticResource PatientMetaItemStyle}" />

                    <!-- العمر -->
                    <HeaderedContentControl Grid.Column="2" Header="العمر" Content="45 سنة" Style="{StaticResource PatientMetaItemStyle}" />

                    <!-- تاريخ الميلاد -->
                    <HeaderedContentControl Grid.Column="3" Header="تاريخ الميلاد" Content="1980/05/12" Style="{StaticResource PatientMetaItemStyle}" />

                    <!-- الحساسية -->
                    <HeaderedContentControl Grid.Column="4" Header="الحساسية" Content="حساسية: البنسلين" Style="{StaticResource PatientMetaItemStyle}"/>


                    <!-- فصيلة الدم -->
                    <HeaderedContentControl Grid.Column="5" Header="فصيلة الدم" Content="0+" Style="{StaticResource PatientMetaItemStyle}" />

                    <!-- حالة الزيارة النشطة -->
                    <Border Grid.Column="6" Background="#F0FDF4" CornerRadius="15" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="● زيارة نشطة" Foreground="#16A34A" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text="فرع الرياض" Foreground="#64748B" FontSize="10" />
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!--شريط التبويبات -->
            <Border Grid.Row="2" Style="{StaticResource MainBorderStyle}">


                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="الملخص" Style="{StaticResource PatientTabButtonStyle}"/>
                    <RadioButton Content="التشخيصات" Style="{StaticResource PatientTabButtonStyle}"/>
                    <RadioButton Content="الادويه" Style="{StaticResource PatientTabButtonStyle}"/>
                    <RadioButton Content="الحساسيه" Style="{StaticResource PatientTabButtonStyle}"/>
                    <RadioButton Content="الزيارات" Style="{StaticResource PatientTabButtonStyle}"/>
                    <RadioButton Content="النتائج" Style="{StaticResource PatientTabButtonStyle}"/>
                    <RadioButton Content="التاريخ المرضي" Style="{StaticResource PatientTabButtonStyle}"/>
                </StackPanel>

            </Border>

            <!--شريط التحذير للتنبيهات-->
            <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}" >
                <!--هنا ستظهر التخذيرات الذي في  اسفل التبويبات-->
                <StackPanel>
                    <TextBlock Text="📝 ملاحظات إضافية" Style="{StaticResource CardHeaderStyle}"/>
                    <TextBox Height="30" TextWrapping="Wrap" AcceptsReturn="True" Text="هنا سوف التنبيهات"/>
                </StackPanel>
            </Border>



            <!--المحتوى الرئيسي-->
            <Border Grid.Row="4" Style="{StaticResource MainBorderStyle}" >
                 <!--هنا ستظهر الواجهات الذي في التبويبات-->
                <ContentControl>
                    <StackPanel>
                        <TextBlock Text="📝 ملاحظات إضافية" Style="{StaticResource CardHeaderStyle}"/>
                        <TextBox Height="30" TextWrapping="Wrap" AcceptsReturn="True" Text="هنا سوف يتم الواجهات الئي ب التبويبات مثل التشخيصات"/>
                    </StackPanel>
                </ContentControl>
            </Border>





        </Grid>


    </Border>
</UserControl>
