<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.PatientAndAppointments.MedicalRecords.Diagnosis.DiagnosticsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.PatientAndAppointments.MedicalRecords.Diagnosis"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
         FlowDirection="RightToLeft">

    <Border   Background="#FFB4D7FA" CornerRadius="2">


        <Grid Margin="5" >
            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>
                <!--شريط عنوان  التشخيصات النشطة  مع زر الاضافة -->
                <RowDefinition Height="170"/>
                <!--  شريط عنوان  تشخيصات سابقة -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0"  Style="{StaticResource MainBorderStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <!--القسم الاول للعنوان والزر -->
                        <RowDefinition Height="Auto"/>
                        <!-- القسم الثاني للبيانات الجدولية -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="التشخيصات النشطة  " Style="{StaticResource CardHeaderStyle}"/>
                        <RadioButton Grid.Column="1" Content="إضافة تشخيص" Style="{StaticResource ButtonADD}" />



                    </Grid>


                    <!-- 4. جدول البيانات (يدعم التمرير الأفقي عند انخفاض المساحة) -->
                    <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}" >

                        <DataGrid >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="50"/>
                                <DataGridTextColumn Header="التشخيص " Width="2*"/>
                                <DataGridTextColumn Header="الرمز" Width="1.5*"/>
                                <DataGridTextColumn Header="النوع" Width="1.5*"/>
                                <DataGridTextColumn Header="الحالة  " Width="80"/>
                                <DataGridTextColumn Header="تاريخ التسجيل  " Width="90"/>
                                <DataGridTextColumn Header="الطبيب" Width="70"/>
                                <DataGridTextColumn Header="الإجراءات" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Border>


                </Grid>

            </Border>

            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <!--القسم الاول لعنوان تشخيصات سابقة -->
                        <RowDefinition Height="Auto"/>
                        <!--   الجدول الذي سوف يعرض البيانات للتشخيصات  -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <TextBlock Grid.Column="0" Text=" تشخيصات سابقة  " Style="{StaticResource CardHeaderStyle}"/>


                    <!-- 4. جدول البيانات (يدعم التمرير الأفقي عند انخفاض المساحة) -->
                    <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}" >

                        <DataGrid >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="50"/>
                                <DataGridTextColumn Header="التشخيص " Width="2*"/>
                                <DataGridTextColumn Header="الرمز" Width="1.5*"/>
                                <DataGridTextColumn Header="النوع" Width="1.5*"/>
                                <DataGridTextColumn Header="الحالة  " Width="80"/>
                                <DataGridTextColumn Header="تاريخ التسجيل  " Width="90"/>
                                <DataGridTextColumn Header="الطبيب" Width="70"/>
                                <DataGridTextColumn Header="الإجراءات" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Border>

                </Grid>
            </Border>




        </Grid>


    </Border>

</UserControl>
