                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0" Text=" معلومات إضافية  " Style="{StaticResource CardHeaderStyle}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">


                        <StackPanel  Margin="0,0,30,0">

                            <TextBlock Text="ضغط الدم الانقباضي" Style="{StaticResource FiledLabelStyle}"/>
                            <Border Style="{StaticResource VitalSignInputContainerStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
