                            <TextBlock Text=" تسجيل قياسات المريض للزيارة الحالية " Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                    </StackPanel>


                 
                
            </Border>

            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">

                <Grid>
                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


