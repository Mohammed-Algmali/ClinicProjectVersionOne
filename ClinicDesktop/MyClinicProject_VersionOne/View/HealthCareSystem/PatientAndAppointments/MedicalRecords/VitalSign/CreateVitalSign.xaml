                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="حمزه مجيب  "  Style="{StaticResource TextBoxStyle}"/>
                                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E0" BorderThickness="1,0,0,0" CornerRadius="5,0,0,5" Padding="6,0" MinWidth="50">
                                        <TextBlock Text="mmHg" FlowDirection="LeftToRight" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel  Margin="0,0,4,0">

                            <TextBlock Text="ضغط الدم الانبساطي" Style="{StaticResource FiledLabelStyle}"/>
