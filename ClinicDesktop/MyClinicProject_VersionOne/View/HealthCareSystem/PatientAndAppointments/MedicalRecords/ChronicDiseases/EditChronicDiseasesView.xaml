<Window x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.PatientAndAppointments.MedicalRecords.ChronicDiseases.EditChronicDiseasesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.PatientAndAppointments.MedicalRecords.ChronicDiseases"
        mc:Ignorable="d"
        Title="EditChronicDiseasesView" Height="600" Width="700"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        >
    <Border  Background="#FFB4D7FA" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <!--العنوان-->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!--هنا ب يكون الرقم حق المرض و تاريخ الانشاء-->

                <!--المحتوي-->
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
                <!--الصف الثالث الذي يحتوي علي الملاحظات-->

                <RowDefinition Height="Auto"/>
                <!--الصف الرابع والذي يحتوي على الازرار-->
            </Grid.RowDefinitions>

            <!--العنوان-->
            <Border Grid.Row="0"  Style="{StaticResource MainBorderStyle}"
                            >
                <Grid >

                    <Grid.ColumnDefinitions>

                        <!-- الصورة -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- العنوان والوصف -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- صورة  -->

                    <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                   Width="42"
                                   Height="42"
                                   Margin="5,5,5,5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>


                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Center">
                        <TextBlock Text="تعديل مرض مزمن"
                                            Style="{StaticResource PrimaryTextTitleadd}"/>

                        <TextBlock Text="قم بادخال بيانات المرض  المسجل في النظام"
                                                Style="{StaticResource SecondaryTextTitlePage}"/>

                    </StackPanel>

                </Grid>
            </Border>

            <!--هنا ب يكون الرقم حق المرض و تاريخ الانشاء-->
            <Border  Grid.Row="1" Style="{StaticResource MainBorderStyle}">

                <Grid  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!--العمود االاول الذي يوجد به الملاحظه-->
                        <ColumnDefinition Width="*"/>
                        <!--العمود الثاني الذي يحنوي علي رقم المرض -->
                        <ColumnDefinition Width="*"/>
                        <!--العمود الثالث والذي يحتوي علي تاريخ الانشاء -->
                    </Grid.ColumnDefinitions>

                    <!--العمود االاول الذي يوجد به الملاحظه-->
                    <StackPanel Grid.Column="0" Margin="0,0,5,0" >
                        <TextBlock Text="📝 بيانات تعريفيه -غير قابله للتعديل" Style="{StaticResource FiledLabelStyle}"/>
                    </StackPanel>


                    <!--العمود الثاني الذي يحنوي علي رقم المرض -->
                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                        <TextBlock Text="رقم الحساسيه*" Style="{StaticResource FiledLabelStyle}"/>
                        <TextBox Grid.Column="0"  
                                     x:Name="txtChronicDiseasesId" Text="DGN-000148" Style="{DynamicResource searchTextBoxStyle}"/>

                    </StackPanel>

                    <!--العمود الثالث والذي يحتوي علي تاريخ الانشاء -->
                    <StackPanel Grid.Column="2" Margin="0,0,5,0">
                        <TextBlock Text="تاربخ الانشاء*"  Style="{StaticResource FiledLabelStyle}"/>
                        <TextBox x:Name="txtChronicDiseasesCreateAt"  Text="2026/02/02" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>


                </Grid>

            </Border>

            <!--المحتوي-->
            <Border  Grid.Row="2" Style="{StaticResource MainBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!--الصف الاول والذي يحتوي علي اسم المرض و الرمز-->

                        <RowDefinition Height="Auto"/>
                        <!--الصف الثاني والذي يحتوي علي الحاله و النوع-->

                    </Grid.RowDefinitions>

                    <!--الصف الاول والذي يحتوي علي اسم المرض و الرمز-->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!--العمود الاول الذي يحتوي على مربع البحث الخاص ب اسم المرض-->
                            <ColumnDefinition Width="*"/>
                            <!--العمود الثاني الذي يحتوي على المرز الخاص ب المرض-->
                        </Grid.ColumnDefinitions>

                        <!--العمود الاول الذي يحتوي على مربع البحث الخاص ب اسم المرض-->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="اسم المرض*" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox Grid.Column="0" 
                                     Tag="اكتب اسم المرض او ICD-10"
                                     x:Name="txtChronicDiseasesName" Style="{DynamicResource searchTextBoxStyle}"/>

                        </StackPanel>

                        <!--العمود الثاني الذي يحتوي على الرمز الخاص ب الحساسيه بيكون نفس ثابت Id-->
                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock Text="الرمز*"  Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtChronicDiseasesCode"  Text="E11.9" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>



                    </Grid>
                    <!--الصف الثاني والذي يحتوي علي الحاله و النوع-->
                    <Grid Grid.Row="1" Margin="0,0,0,10" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!--العمود الاول الذي يحتوي على الحاله  الخاص ب  المرض-->
                            <ColumnDefinition Width="*"/>
                            <!--العمود الثاني الذي يحتوي على النوع الخاص ب المرض-->
                        </Grid.ColumnDefinitions>

                        <!--العمود الاول الذي يحتوي على الحاله  الخاص ب  المرض-->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="حاله الحساسيه*" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox  x:Name="txtChronicDiseasesStatus" Style="{StaticResource ModernComboBoxStyle }" />
                        </StackPanel>

                        <!--العمود الثاني الذي يحتوي على النوع الخاص ب الحساسيه-->
                        <StackPanel Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock Text="نوع الحساسيه*"  Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox  x:Name="txtChronicDiseasesType" Style="{StaticResource ModernComboBoxStyle }"  >
                                <!--//////////////////////
                                هذا مثال ويجب حذفه-
                                ////////////////////////
                                -->
                                <ComboBoxItem Content="خيار اول"/>
                            </ComboBox>
                        </StackPanel>

                    </Grid>






                </Grid>

            </Border>
            <!--الصف الثالث الذي يحتوي علي الملاحظات-->
            <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}">
                <StackPanel >
                    <TextBlock Text="📝 ملاحظات إضافية" Style="{StaticResource CardHeaderStyle}"/>
                    <TextBox x:Name="txtChronicDiseasesNotes" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True" Text="/ btnEditChronicDiseasesSave / btnEditChronicDiseasesExit / txtChronicDiseasesCreateAt / txtChronicDiseasesId / txtChronicDiseasesNotes / txtChronicDiseasesName / txtChronicDiseasesCode /  txtChronicDiseasesStatus /  txtChronicDiseasesType /  تم تسميه جميع الازرار مع الحقول كل شي جاهز ....."/>
                    <TextBlock Text="0/500" FontSize="10" Foreground="Gray" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>



            <!--الصف الرابع والذي يحتوي على الازرار-->

            <Border Grid.Row="4" 
                Style="{StaticResource MainBorderStyle}">

                <StackPanel 
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight"
>
                    <!-- زر الإلغاء -->

                    <Button Style="{StaticResource ButtonExit}"
                            x:Name="btnEditChronicDiseasesExit"
                             />


                    <!-- زر الحفظ تم تسميه كل مافي الواجهه -->

                    <Button Style="{StaticResource ButtonSave}"
                            x:Name="btnEditChronicDiseasesSave"
                                 />


                </StackPanel>

            </Border>



        </Grid>

    </Border>
</Window>
