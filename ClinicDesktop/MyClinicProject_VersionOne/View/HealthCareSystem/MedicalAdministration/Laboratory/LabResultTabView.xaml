<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.Laboratory.LabResultTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.Laboratory"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
              FlowDirection="RightToLeft">

    <Border   Background="#FFB4D7FA" CornerRadius="2">


        <Grid Margin="0" >
            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>
                <!--شريط عنوان طلبات الفحوصات المختبرية     -->

            </Grid.RowDefinitions>

            <Border Grid.Row="0"  Style="{StaticResource MainBorderStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <!--القسم الاول -->
                        <RowDefinition Height="Auto"/>
                        <!-- القسم الثاني للبيانات الجدولية -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text=" عرض كل نتائج الفحوصات المطلوبة " Style="{StaticResource CardHeaderStyle}"/>
                        <RadioButton  Grid.Column="1" Content="  طباعة " Style="{StaticResource ButtonPrint}" />



                    </Grid>


                    <!-- 4. جدول البيانات (يدعم التمرير الأفقي عند انخفاض المساحة) -->
                    <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}" >

                        <DataGrid >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الطلب" Width="*"/>
                                <DataGridTextColumn Header="اسم المريض" Width="1.5*"/>
                                <DataGridTextColumn Header="المكونات" Width="*"/>
                                <DataGridTextColumn Header=" النتائج " Width="1.5*"/>
                                <DataGridTextColumn Header="التاريخ" Width="1.5*"/>
                                <DataGridTextColumn Header="الحالة" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Border>


                </Grid>

            </Border>






        </Grid>


    </Border>
</UserControl>