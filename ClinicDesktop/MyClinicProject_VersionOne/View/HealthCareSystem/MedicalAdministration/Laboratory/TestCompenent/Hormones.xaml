<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.Laboratory.TestCompenent.Hormones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.Laboratory.TestCompenent"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             FlowDirection="RightToLeft">

    <Border  Background="#FFB4D7FA" CornerRadius="2">



        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="  فحوصات الهرمونات " FontSize="16" FontWeight="Bold" Foreground="#0066FF"/>
                <TextBlock Text="اختر الفحص" FontSize="11" Foreground="Gray" Margin="0,2,0,15"/>

                <UniformGrid Columns="3" Rows="4">
                    <CheckBox Content="إدارة المواعيد"  Margin="5,8"/>
                    <CheckBox Content="إدارة المرضى"  Margin="5,8"/>
                    <CheckBox Content="إدارة المختبر"  Margin="5,8"/>

                    <CheckBox Content="السجلات الطبية"  Margin="5,8"/>
                    <CheckBox Content="الملفات الطبية"  Margin="5,8"/>
                    <CheckBox Content="التقارير المتقدمة"  Margin="5,8"/>

                    <CheckBox Content="الطوارئ" Margin="5,8"/>
                    <CheckBox Content="الوصفات الطبية"  Margin="5,8"/>
                    <CheckBox Content="الذكاء الاصطناعي"  Margin="5,8"/>

                    <CheckBox Content="التقارير المالية"  Margin="5,8"/>
                    <CheckBox Content="الإشعارات والتذكيرات"  Margin="5,8"/>
                    <CheckBox Content="الدعم الفني المميز"  Margin="5,8"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>