<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.Laboratory.TestCompenent.ImmunologyAndSerology"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.Laboratory.TestCompenent"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
              FlowDirection="RightToLeft">

    <Border  Background="#FFB4D7FA" CornerRadius="2">



        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="  فحوصات المناعه و السيرولوجيا " FontSize="16" FontWeight="Bold" Foreground="#0066FF"/>
                <TextBlock Text="اختر الفحص" FontSize="11" Foreground="Gray" Margin="0,2,0,15"/>

                <UniformGrid Columns="3" Rows="4">

                    <CheckBox Content=" البروتين المتفاعل C "  Margin="5,8"/>
                    <CheckBox Content=" العامل الروماتويدي "  Margin="5,8"/>
                    <CheckBox Content=" مضاد الستربتوليزين O "  Margin="5,8"/>

                    <CheckBox Content=" الأجسام المضادة للنواة "  Margin="5,8"/>
                    <CheckBox Content=" جسام مضادة للحمض النووي مزدوج السلسلة "  Margin="5,8"/>
                    <CheckBox Content=" مستضد سطح التهاب الكبد B "  Margin="5,8"/>

                    <CheckBox Content=" الأجسام المضادة لسطح التهاب الكبد B "  Margin="5,8"/>
                    <CheckBox Content=" الأجسام المضادة لالتهاب الكبد C "  Margin="5,8"/>
                    <CheckBox Content=" فحص مستضد/أجسام مضادة لفيروس HIV "  Margin="5,8"/>

                    <CheckBox Content=" فحوصات تحرّي الزهري "  Margin="5,8"/>
                    <CheckBox Content=" مستضد حمى الضنك NS1 "  Margin="5,8"/>
                    <CheckBox Content="  أجسام مضادة IgM للضنك "  Margin="5,8"/>

                    <CheckBox Content="  أجسام مضادة IgG للضنك "  Margin="5,8"/>
                    <CheckBox Content=" جسام مضادة لجرثومة المعدة "  Margin="5,8"/>
                    <CheckBox Content=" عيار ASO "  Margin="5,8"/>

                    <CheckBox Content=" الغلوبولين المناعي IgG "  Margin="5,8"/>
                    <CheckBox Content=" الغلوبولين المناعي IgM "  Margin="5,8"/>
                    <CheckBox Content=" الغلوبولين المناعي IgA "  Margin="5,8"/>

                    <CheckBox Content=" المتممة C3 "  Margin="5,8"/>
                    <CheckBox Content=" المتممة C4 "  Margin="5,8"/>
                    <CheckBox Content=" الأجسام المضادة للببتيد السيتروليني "  Margin="5,8"/>

                </UniformGrid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
