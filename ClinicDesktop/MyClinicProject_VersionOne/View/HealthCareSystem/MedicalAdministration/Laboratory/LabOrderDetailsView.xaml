<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.Laboratory.LabOrderDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.Laboratory"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             
             FlowDirection="RightToLeft">

    <Border   Background="#FFB4D7FA" CornerRadius="2" >


        <Grid Margin="5" >
            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!--شريط عنوان طلبات الفحوصات المختبرية     -->
                <RowDefinition Height="Auto"/>
                <!--   شريط عنوان    تفاصيل الفحوصات المخبرية      -->
                <RowDefinition Height="Auto"/>
                <!-- ازرار الارسال و التعديل -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0"  Style="{StaticResource MainBorderStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <!--القسم الاول -->
                        <RowDefinition Height="Auto"/>
                        <!-- القسم الثاني للبيانات الجدولية -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="تفاصيل طلب الفحص    " Style="{StaticResource CardHeaderStyle}"/>

                        <Border Grid.Column="1" 
                                Padding="7"                             
                                Background="Orange"
                                CornerRadius="8"
                                BorderThickness="1">
                            <TextBlock  Text=" بإنتظار المختبر " 
                                         Foreground="White"
                                        FontWeight="Bold" FontSize="11" 
                                        TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>


                    </Grid>




                </Grid>

            </Border>

            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--البطاقة الاولى الصف صفر العمود صفر-->
                    <Border Grid.Row="0" Grid.Column="0"   CornerRadius="8"   >
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="المريض " 
                            Content="{Binding TotalEmployeesCount, FallbackValue=سامي محمد علي }"
                            Tag="👥"/>
                    </Border>

                    <!--البطاقة الثانية الصف صفر العمود واحد-->
                    <Border  Grid.Row="0" Grid.Column="1"   CornerRadius="8"   >
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header=" اسم الطبيب" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=احمد محمد على خالد}"
                            Tag="👥"/>
                    </Border>

                    <!--البطاقة الثالث الصف واحد العمود صفر-->
                    <Border  Grid.Row="1" Grid.Column="0"   CornerRadius="8"   >
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header=" تاريخ الطلب" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>

                    <!--البطاقة الرابع الصف واحد العمود واحد-->
                    <Border  Grid.Row="1" Grid.Column="1"   CornerRadius="8"   >
                        <HeaderedContentControl Style="{StaticResource StatisticCardStyle}"
                            Header="إجمالي الموظفين" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}"
                            Tag="👥"/>
                    </Border>

                </Grid>



            </Border>

            <Border Grid.Row="2" Style="{StaticResource MainBorderStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <!--القسم الاول لعنوان  الفحوصات   تفاصيل الفحوصات في الطلب -->
                        <RowDefinition Height="Auto"/>
                        <!--   الجدول الذي سوف يعرض البيانات تفاصيل الطلب   -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text=" تفاصيل الفحوصات في الطلب" Style="{StaticResource CardHeaderStyle}"/>

                    </Grid>



                    <!-- 4. جدول البيانات (يدعم التمرير الأفقي عند انخفاض المساحة) -->
                    <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}" >

                        <DataGrid >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="50"/>
                                <DataGridTextColumn Header="اسم الدواء" Width="2*"/>
                                <DataGridTextColumn Header="الجرعة" Width="1.5*"/>
                                <DataGridTextColumn Header="الطريق" Width="1.5*"/>
                                <DataGridTextColumn Header="التكرار  " Width="80"/>
                                <DataGridTextColumn Header="فترة الاستخدام  " Width="90"/>
                                <DataGridTextColumn Header="سبب الايقاف" Width="70"/>
                                <DataGridTextColumn Header="الوصف " Width="80"/>
                                <DataGridTextColumn Header="المصدر" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Border>

                </Grid>
            </Border>

            <Border Grid.Row="3" 
                Style="{StaticResource MainBorderStyle}">

                <StackPanel 
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight"
>
                    <RadioButton Content="  تعديل الطلب" Style="{StaticResource ButtonEdit}" />
                    <RadioButton Content="ارسال الى المختبر" Style="{StaticResource ButtonADD}" />



                </StackPanel>

            </Border>



        </Grid>


    </Border>
</UserControl>
