<Window x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.PharmacyUnit.Medicen.EditeMedicen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.PharmacyUnit.Medicen"
        mc:Ignorable="d"
        Title="EditeMedicen" Height="380" Width="800"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FlowDirection="RightToLeft">
    <Border  Background="#FFB4D7FA" CornerRadius="2">

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource MainBorderStyle}"
                            >
                <Grid >

                    <Grid.ColumnDefinitions>

                        <!-- الصورة -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- العنوان  -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- صورة المستخدم -->

                    <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                  Style="{StaticResource ImageHeaderStyle}"/>


                    <!-- العنوان -->

                    <StackPanel Grid.Column="1"
                              >


                        <TextBlock Text="تعديل دواء   "
                                              Style="{StaticResource PrimaryTextTitleadd}"/>

                        <TextBlock   Text="قم بتعديل بيانات الدواء  الموجود في النظام" 
                                              Style="{StaticResource SecondaryTextTitlePage}"/>


                    </StackPanel>

                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">

                <StackPanel>



                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0" Margin="0,0,5,0">

                            <TextBlock Text="  اسم الدواء "
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtMedicenlName"
                                 Style="{StaticResource TextBoxStyle}" />

                        </StackPanel>



                        <StackPanel Grid.Column="1"
                                Margin="0,0,5,0">

                            <TextBlock Text=" التركيز "
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtFocsedName"
                                 Style="{StaticResource TextBoxStyle}"/>

                        </StackPanel>




                        <StackPanel Grid.Column="2" Margin="0,0,5,0">

                            <TextBlock Text=" الشكل الصيدلاني *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtMedicenFormat" 
                                     Style="{StaticResource TextBoxStyle}"/>


                        </StackPanel>





                    </Grid>


                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>




                        <StackPanel Grid.Column="0" Margin="0,0,5,0">


                            <TextBlock Text=" النوع "
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtMedicenType"
                                 Style="{StaticResource TextBoxStyle}"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1" Margin="0,0,5,0">


                            <TextBlock Text="الجرعة الموصى بها *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtGorah"
                                 Style="{StaticResource TextBoxStyle}"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2" Margin="0,0,5,0">


                            <TextBlock Text=" التعليمات الاضافية *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                            <TextBox x:Name="txtAddingSteps"
                                 Style="{StaticResource TextBoxStyle}"/>

                        </StackPanel>

                    </Grid>

                    <Grid Margin="0,40,0,0" >
                        <TextBlock Text="ملاحظة*"
                                   Style="{StaticResource FiledLabelStyle}"/>
                    </Grid>


                </StackPanel>

            </Border>

            <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}">

                <StackPanel 
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight">

                    <RadioButton Content="  إلغاء " Style="{StaticResource ButtonCancel}" />
                    <RadioButton Content="  حفظ  التعديلات " Style="{StaticResource ButtonADD}" />

                </StackPanel>

            </Border>



        </Grid>

    </Border>
</Window>
