<Window x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.PharmacyUnit.Prescription.CreatePrescription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.MedicalAdministration.PharmacyUnit.Prescription"
        mc:Ignorable="d"
        Title="CreatePrescription" Height="450" Width="800"
           Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
         FlowDirection="RightToLeft">


    <Border Background="#FFB4D7FA" CornerRadius="2">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <!--  العنوان وبيانات المريض -->
                <RowDefinition Height="Auto"/>
                <!--  إضافة دواء للوصفة -->
                <RowDefinition Height="Auto"/>
                <!--  جدول الأدوية المضافة في الوصفة -->
                <RowDefinition Height="*"/>
                <!-- الملاحظات -->
                <RowDefinition Height="Auto"/>
                <!--  أزرار الحفظ والإلغاء -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--  رأس الصفحة بيانات المريض الأساسية -->
            <Border Grid.Row="0" Style="{StaticResource MainBorderStyle}"
                            >
                <Grid >

                    <Grid.ColumnDefinitions>

                        <!-- الصورة -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- العنوان والوصف -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- صورة المستخدم -->

                    <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                 Style="{StaticResource ImageHeaderStyle}"
                                 />


                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                               >


                        <TextBlock Text="إنشاء وصفة طبية جديدة" Style="{StaticResource PrimaryTextTitleadd}"/>
                        <TextBlock Text="إضافة الأدوية والجرعات وإرشادات الاستخدام للمريض" Style="{StaticResource SecondaryTextTitlePage}"/>



                    </StackPanel>

                </Grid>
            </Border>

            <!-- إدخال بيانات الدواء والجرعة -->
            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">
                <StackPanel>
                    <TextBlock Text=" إضافة دواء إلى الوصفة" Style="{StaticResource CardHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- اسم الدواء -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="اسم الدواء العلمي / التجاري *" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox Text="{Binding NewDrugName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <!-- الجرعة وبجانبها وحدة ثابتة mg -->
                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                            <TextBlock Text="التركيز / الجرعة *" Style="{StaticResource FiledLabelStyle}"/>
                            <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="5" Background="White" Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewDosage, FallbackValue='500', UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" FontWeight="Bold"/>
                                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E0" BorderThickness="1,0,0,0" Padding="8,0">
                                        <TextBlock Text="mg" FlowDirection="LeftToRight" VerticalAlignment="Center" Foreground="#64748B" FontSize="11"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- التكرار اليومي -->
                        <StackPanel Grid.Column="2" Margin="5,0,5,0">
                            <TextBlock Text="التكرار *" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox SelectedItem="{Binding SelectedFrequency}" Height="36">
                                <ComboBoxItem Content="مرة واحدة يومياً" IsSelected="True"/>
                                <ComboBoxItem Content="مرتين يومياً (كل 12 ساعة)"/>
                                <ComboBoxItem Content="3 مرات يومياً (كل 8 ساعات)"/>
                                <ComboBoxItem Content="عند اللزوم"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- المدة وبجانبها وحدة ثابتة (يوم) -->
                        <StackPanel Grid.Column="3" Margin="5,0,5,0">
                            <TextBlock Text="مدة العلاج *" Style="{StaticResource FiledLabelStyle}"/>
                            <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="5" Background="White" Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewDurationDays, FallbackValue='7', UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" FontWeight="Bold"/>
                                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E0" BorderThickness="1,0,0,0" Padding="8,0">
                                        <TextBlock Text="أيام" VerticalAlignment="Center" Foreground="#64748B" FontSize="11"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- تعليمات الاستخدام (قبل/بعد الأكل) -->
                        <StackPanel Grid.Column="4" Margin="5,0,8,0">
                            <TextBlock Text="تعليمات الاستخدام" Style="{StaticResource FiledLabelStyle}"/>
                            <ComboBox SelectedIndex="0" Height="36">
                                <ComboBoxItem Content="بعد الأكل"/>
                                <ComboBoxItem Content="قبل الأكل بنصف ساعة"/>
                                <ComboBoxItem Content="قبل النوم"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- زر إدراج الدواء للجدول -->
                        <Button Grid.Column="5" 
                                Content="+ إدراج للوصفة" 
                                Command="{Binding AddMedicationItemCommand}"
                                VerticalAlignment="Bottom" Height="36" Padding="14,0"
                                Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- قائمة الأدوية المدرجة في الوصفة الحالية -->
            <Border Grid.Row="2" Style="{StaticResource MainBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text=" الأدوية المدرجة في الوصفة" Style="{StaticResource CardHeaderStyle}"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CurrentPrescriptionItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="40"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="0.4*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="اسم الدواء" Binding="{Binding DrugName}" Width="1.8*"/>
                            <DataGridTextColumn Header="التركيز / الجرعة" Binding="{Binding DosageWithUnit}" Width="1*"/>
                            <DataGridTextColumn Header="التكرار" Binding="{Binding Frequency}" Width="1.2*"/>
                            <DataGridTextColumn Header="المدة" Binding="{Binding Duration}" Width="0.8*"/>
                            <DataGridTextColumn Header="تعليمات الاستخدام" Binding="{Binding Instructions}" Width="1.3*"/>
                            <DataGridTemplateColumn Header="حذف" Width="0.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" 
                                                Command="{Binding DataContext.RemoveMedicationItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Foreground="#DC2626" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!--  ملاحظات الطبيب  -->
            <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}">


                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="📝 ملاحظات وتوصيات للصيدلي / المريض" Style="{StaticResource CardHeaderStyle}"/>
                    <TextBox Height="48" TextWrapping="Wrap" AcceptsReturn="True" 
                                 Text="{Binding PrescriptionNotes, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

            </Border>

            <!--  أزرار الحفظ والطباعة والإلغاء -->
            <Border Grid.Row="4" Style="{StaticResource MainBorderStyle}">
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="15,5,15,12">
                    <Button Command="{Binding SavePrescriptionCommand}" Style="{StaticResource ButtonSave}"/>
                    <Button Command="{Binding CancelCommand}" Style="{StaticResource ButtonExit}"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>