<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources.EmployeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
               FlowDirection="RightToLeft">
    <Border   Background="#FFB4D7FA" CornerRadius="2">

        
            <Grid Margin="5" >
                <Grid.RowDefinitions>
                  
                    <!-- العنوان والنص التوضيحي -->
                    <RowDefinition Height="Auto"/>
                   
                    <!-- بطاقات الإحصائيات -->
                    <RowDefinition Height="Auto"/>
                    <!-- شريط البحث والفلترة -->
                    <RowDefinition Height="Auto"/>
                    <!-- جدول البيانات -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. العنوان والنص التوضيحي -->
                <!-- العنوان والوصف -->
                <Border Grid.Row="0" Style="{StaticResource MainBorderStyle}"
                            >
                    <Grid >

                        <Grid.ColumnDefinitions>

                            <!-- الصورة -->
                            <ColumnDefinition Width="Auto"/>

                            <!-- العنوان والوصف -->
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- صورة المستخدم -->

                        <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                 Style="{StaticResource ImageHeaderStyle}"/>


                        <!-- العنوان والوصف -->

                        <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                >


                            <TextBlock Text=" ادارة الموظفين"
                                              Style="{StaticResource PrimaryTextTitleadd}"/>

                            <TextBlock   Text="عرض وادارة جميع الموظفين الموجودين في النظام" 
                                              Style="{StaticResource SecondaryTextTitlePage}"/>


                        </StackPanel>

                    </Grid>
                </Border>

                <!-- بطاقات الإحصائيات -->
            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!--البطاقه الاولى-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الثانيه-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الثالث-->
                        <ColumnDefinition Width="*"/>
                        <!--البطاقه الرابعه-->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--البطاقه الاولى وهي تجريبي-->
                    <HeaderedContentControl Grid.Column="0"  Style="{StaticResource StatisticCardStyle}"
                            Header="الادوار النشطه" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}" 
                            Tag="👥" />



                    <!--البطاقه الثانيه-->
                    
                     <HeaderedContentControl Grid.Column="1"  Style="{StaticResource StatisticCardStyle}"
                            Header="الادوار النشطه" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}" 
                            Tag="👥" />
                    

                    <!--البطاقه الثالثه-->
                    <HeaderedContentControl Grid.Column="2"  Style="{StaticResource StatisticCardStyle}"
                            Header="الادوار النشطه" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}" 
                            Tag="👥" />
                    <!--البطاقه الرابعه-->
                    <HeaderedContentControl Grid.Column="3"  Style="{StaticResource StatisticCardStyle}"
                            Header="الادوار النشطه" 
                            Content="{Binding TotalEmployeesCount, FallbackValue=142}" 
                            Tag="👥" />



                </Grid>

            </Border>


            <!-- 3. شريط البحث والفلترة (يتأقلم مع الشاشات الصغيرة) -->
                <Border Grid.Row="2" Style="{StaticResource MainBorderStyle}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>



                            <TextBox Grid.Column="0"  Margin="0,0,5,0"
                                 Style="{DynamicResource searchTextBoxStyle}"
                                 Tag="ابحث بالاسم اورقم الهاتف"/>


                        <ComboBox Grid.Column="1"
                            x:Name="cmbPermi"
                               
                                Style="{StaticResource ModernComboBoxStyle}"/>

                        <ComboBox Grid.Column="2"
                               
                                Style="{StaticResource ModernComboBoxStyle}"/>

                        <Button Grid.Column="3" Content="فلترة 🔽" Background="White" Foreground="#475569" Padding="12,8" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,5,0"/>

                        <RadioButton Grid.Column="4"
                                     x:Name="btnCreateEmployee"
                                     Click="btnCreateEmployee_Click"
                             Style="{StaticResource ButtonADD}"
                             Content="اضافه موظف جديد"
                             />


                    </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. جدول البيانات (يدعم التمرير الأفقي عند انخفاض المساحة) -->
                <Border Grid.Row="3" Style="{StaticResource MainBorderStyle}" >

                <DataGrid ItemsSource="{Binding Employees}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          CanUserAddRows="False"
          GridLinesVisibility="Horizontal"
          HeadersVisibility="Column"
          RowHeight="36"
          FontSize="13"
          HorizontalGridLinesBrush="#E2E8F0"
          FlowDirection="RightToLeft">

                    <DataGrid.Columns>

                        <!-- 1. الرقم الوظيفي -->
                        <DataGridTextColumn Header="الرقم الوظيفي" 
                            Binding="{Binding EmployeeId}" 
                            Width="100"/>

                        <!-- 2. الاسم الكامل -->
                        <DataGridTextColumn Header="اسم الموظف / الطبيب" 
                            Binding="{Binding UserFullName}" 
                            Width="180"/>

                        <!-- 3. اسم المستخدم -->
                        <DataGridTextColumn Header="اسم الدخول" 
                            Binding="{Binding Username}" 
                            Width="120"/>

                        <!-- 4. الدور الوظيفي -->
                        <DataGridTextColumn Header="الدور الوظيفي" 
                            Binding="{Binding RoleName}" 
                            Width="130"/>

                        <!-- 5. التخصص الطبي (يظهر للأطباء، وإن لم يوجد يظهر فارغاً) -->
                        <DataGridTextColumn Header="التخصص" 
                            Binding="{Binding Specialization}" 
                            Width="140"/>

                        <!-- 6. رقم ترخيص المزاولة -->
                        <DataGridTextColumn Header="ترخيص المزاولة" 
                            Binding="{Binding MedicalLicenseNumber}" 
                            Width="130"/>

                        <!-- 7. رقم الهاتف -->
                        <DataGridTextColumn Header="رقم الهاتف" 
                            Binding="{Binding UserPhone}" 
                            Width="120"/>

                        <!-- 8. البريد الإلكتروني (يتوسع تلقائياً ليأخذ باقي المساحة) -->
                        <DataGridTextColumn Header="البريد الإلكتروني" 
                            Binding="{Binding UserEmail}" 
                            Width="*"/>

                        <!-- 9. الحالة الوظيفية -->
                        <DataGridTextColumn Header="الحالة" 
                            Binding="{Binding EmployeeStatus}" 
                            Width="90"/>


                        <DataGridTemplateColumn Header="الإجراءات"
                        Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="تعديل"
                                 Width="60"
                                 Margin="2"
                                    Command="{Binding DataContext.EditFacilityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                     CommandParameter="{Binding EmployeeId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                   

                    </DataGrid.Columns>
                </DataGrid>

            </Border>





            </Grid>
        

    </Border>
</UserControl>
