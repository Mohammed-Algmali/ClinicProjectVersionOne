<Window x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources.CreateEmployeeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources"
       xmlns:helpers="clr-namespace:MyClinicProject_VersionOne.Helpers"
        mc:Ignorable="d"
        Title="CreateEmployeeView"  Width="800" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
           FlowDirection="RightToLeft">
    <Border   Background="#FFB4D7FA" CornerRadius="2">



        <ScrollViewer VerticalScrollBarVisibility="Hidden"   >
            <StackPanel >

                <!-- العنوان والوصف -->
                <Border Background="White" Style="{StaticResource MainBorderStyle}"
                            >
                    <Grid >

                        <Grid.ColumnDefinitions>

                            <!-- الصورة -->
                            <ColumnDefinition Width="Auto"/>

                            <!-- العنوان والوصف -->
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- صورة المستخدم -->

                        <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                 Style="{StaticResource ImageHeaderStyle}"/>


                        <!-- العنوان والوصف -->

                        <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                               >

                            <TextBlock Text="إنشاء موظف جديد"
                                            Style="{StaticResource PrimaryTextTitleadd}"/>

                            <TextBlock Text="قم بادخال بيانات الموظف  الجديد في النظام"
                                                Style="{StaticResource SecondaryTextTitlePage}"/>

                        </StackPanel>

                    </Grid>
                </Border>

                <!--"❶ البيانات الأساسية"-->
                <Border Background="White" Style="{StaticResource MainBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="❶ البيانات الأساسية" Style="{StaticResource CardHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="الاسم الكامل*" Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox  x:Name="txtEmployeeName"
                                 Style="{StaticResource TextBoxStyle}"
                                   Text="{Binding UserFullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                <TextBlock Text="*تاريخ الميلاد"  Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox  x:Name="txtEmployeeBirthDate"
                                 Style="{StaticResource TextBoxStyle}"
                                   Text="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="2" Margin="0,0,5,0">
                             
                                    <TextBlock Text="الجنس *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                                <ComboBox ItemsSource="{Binding GendersList}"
                             SelectedItem="{Binding Gender}"
                                             Style="{StaticResource ModernComboBoxStyle}"/>

                              

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--"❷ العنوان ومعلومات التواصل"-->
                <Border Background="White" Style="{StaticResource MainBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="❷ العنوان ومعلومات التواصل" Style="{StaticResource CardHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text=" الهاتف*" Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox x:Name="txtPhone"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding UserPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                <TextBlock Text="* الايميل" Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox x:Name="txtEmail"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                <TextBlock Text=" العنوان*" Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox x:Name="txtAddress"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding UserAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            </StackPanel>



                        </Grid>
                    </StackPanel>
                </Border>

                <!--"❷المؤهلات العلميه والتراخيص"-->
                <Border Style="{StaticResource MainBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="❷المؤهلات العلميه والتراخيص" Style="{StaticResource CardHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="المؤهل العلمي*" Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox x:Name="txtQualification"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding Qualification, UpdateSourceTrigger=PropertyChanged}"/>  
                            </StackPanel>


                            <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                <TextBlock Text="*شهاده البورد/التتخصص"  Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox x:Name="txtSpecialization"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                <TextBlock Text="التراخيص المهنيه*" Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox x:Name="txtMedicalLicense"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding MedicalLicenseNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>



                        </Grid>
                    </StackPanel>
                </Border>

                <!--"بيانات الوظيفة"-->
                

                <!--"صلاحيات النظام"-->
                <Border Style="{StaticResource MainBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="صلاحيات النظام" Style="{StaticResource CardHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">


                                <TextBlock Text="الصلاحيات *"
                                   Style="{StaticResource FiledLabelStyle}"/>

                                <ComboBox ItemsSource="{Binding RolesList}"
                                      SelectedValuePath="RoleId"
                                      DisplayMemberPath="RoleName"
                                      SelectedValue="{Binding SelectedRoleId}"                          
                                Style="{StaticResource ModernComboBoxStyle}"/>

                            </StackPanel>



                            <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                <TextBlock Text="اسم المستخدم*" Style="{StaticResource FiledLabelStyle}"/>
                                <TextBox x:Name="txtUsername"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                <TextBlock Text="كلمه المرور الاوليه*" Style="{StaticResource FiledLabelStyle}"/>
                                <PasswordBox x:Name="pbPassword"
                                     Style="{StaticResource PasswordBoxStyle}"
                                     helpers:PasswordHelper.Attach="True"
                                     helpers:PasswordHelper.Password="{Binding UserPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Border>

                <!--ملاحظات إضافية-->
                <!--كلمه المرور لم افعل لها تنسيق وهي و الملاحظات-->
                <Border Style="{StaticResource MainBorderStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="رقم هاتف الطوارى*" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox x:Name="txtEmergencyPhone"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding EmergencyContactPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="📝 ملاحظات إضافية" Style="{StaticResource CardHeaderStyle}"/>
                            <TextBox Height="60" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="0/500" FontSize="10" Foreground="Gray" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                   
                </Border>


                <!--الازرار  -->
                <Border Style="{StaticResource MainBorderStyle}">

                    <StackPanel 
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight"
                            >

                        <!-- زر الحفظ -->

                        <Button Style="{StaticResource ButtonSave}"
                                Command="{Binding SaveEmployeeCommand}"
                                 />

                        <!-- زر الإلغاء -->

                        <Button Style="{StaticResource ButtonExit}"
                                Command="{Binding CancelCommand}"
                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                
                                
                             />

                    </StackPanel>

                </Border>
            </StackPanel>
        </ScrollViewer>







    </Border>
</Window>
