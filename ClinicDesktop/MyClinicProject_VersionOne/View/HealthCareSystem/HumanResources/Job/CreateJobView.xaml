<Window x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources.Job.CreateJobView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources.Job"
        mc:Ignorable="d"
        Title="CreateJobView"  Width="580" Height="310"
         WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
           FlowDirection="RightToLeft">
    <Border   Background="#FFB4D7FA" CornerRadius="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
              
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource MainBorderStyle}"
                            >
                <Grid >

                    <Grid.ColumnDefinitions>

                        <!-- الصورة -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- العنوان والوصف -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- صورة المستخدم -->

                    <Image Grid.Column="0"
                                   Source="/Styles/Images/user.png"
                                 Style="{StaticResource ImageHeaderStyle}"/>


                    <!-- العنوان والوصف -->

                    <StackPanel Grid.Column="1"
                              
                               >

                        <TextBlock Text="إنشاء وظيفه جديده"
                                            Style="{StaticResource PrimaryTextTitleadd}"/>

                        <TextBlock Text="قم بادخال بيانات الزظيفه  الجديده في النظام"
                                                Style="{StaticResource SecondaryTextTitlePage}"/>

                    </StackPanel>

                </Grid>
            </Border>

            <!--"❶ البيانات الأساسية"-->
            <Border Grid.Row="1" Style="{StaticResource MainBorderStyle}">
                <StackPanel>
                    <TextBlock Text="❶ البيانات الأساسية" Style="{StaticResource CardHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="اسم الوظيفه" Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox  Text="مثال: موظف استقبال " Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                       

                        <StackPanel Grid.Column="2" Margin="0,0,5,0">
                            <TextBlock Text="*الوصف"  Style="{StaticResource FiledLabelStyle}"/>
                            <TextBox  Text="أدخل وصف الوظيفه   ..." Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>



                    </Grid>
                </StackPanel>
            </Border>

           

            <Border Grid.Row="2"  Style="{StaticResource MainBorderStyle}">

                <StackPanel 
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight"
                        >

                    <!-- زر الحفظ -->

                    <Button Style="{StaticResource ButtonSave}"
                                 />

                    <!-- زر الإلغاء -->

                    <Button Style="{StaticResource ButtonExit}"
                             />

                </StackPanel>

            </Border>
        </Grid>



    </Border>
</Window>