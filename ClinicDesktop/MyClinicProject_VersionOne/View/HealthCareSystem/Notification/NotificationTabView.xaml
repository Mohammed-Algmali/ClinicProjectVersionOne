<UserControl x:Class="MyClinicProject_VersionOne.View.HealthCareSystem.Notification.NotificationTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.Notification"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
              FlowDirection="RightToLeft">

    <Border Margin="20">



        <!-- قائمة الإشعارات -->
        <Border Style="{StaticResource MainBorderStyle}" >

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- العنوان -->

                <TextBlock Grid.Row="0" Text="الإشعارات" Style="{StaticResource CardHeaderStyle}" />

                <!-- التصنيفات -->
                <WrapPanel Grid.Row="1"
                           Margin="0,0,0,20">

                    <RadioButton Content="الكل"
                            Tag="all"
                          
                            Style="{StaticResource PatientTabButtonStyle}"/>

                    <RadioButton Content="المستخدمون"
                            Tag="users"
                          
                            Style="{StaticResource PatientTabButtonStyle}"/>

                    <RadioButton Content="المواعيد"
                            Tag="appointments"
                           
                            Style="{StaticResource PatientTabButtonStyle}"/>

                    <RadioButton Content="المختبر"
                            Tag="laboratory"
                           
                            Style="{StaticResource PatientTabButtonStyle}"/>

                    <RadioButton Content="الاشتراكات"
                            Tag="subscriptions"
                           
                            Style="{StaticResource PatientTabButtonStyle}"/>

                    <RadioButton Content="النظام"
                            Tag="system"
                            
                            Style="{StaticResource PatientTabButtonStyle}"/>
                </WrapPanel>

                <!-- بطاقات الإشعارات -->
                <ListBox x:Name="NotificationsList"
                         Grid.Row="2"
                         ItemsSource="{Binding Notifications}"
                         SelectedItem="{Binding SelectedNotification, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                       >

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Padding="14"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="#DCEAF5"
                                    Background="#F8FCFF">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="25"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- الأيقونة -->
                                    <Border Grid.Column="0"
                                            Width="45"
                                            Height="45"
                                            CornerRadius="25"
                                            Background="#E4F3FF"
                                            HorizontalAlignment="Center">

                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="23"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- العنوان والوصف -->
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0">

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#173F68"/>

                                        <TextBlock Text="{Binding ShortMessage}"
                                                   FontSize="13"
                                                   Foreground="#66788A"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- التصنيف والتاريخ -->
                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Center">

                                        <Border Background="{Binding CategoryColor}"
                                                CornerRadius="12"
                                                Padding="10,4">

                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="{Binding DisplayTime}"
                                                   FontSize="11"
                                                   Foreground="#687C91"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="{Binding DisplayDate}"
                                                   FontSize="11"
                                                   Foreground="#687C91"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- سهم الانتقال -->
                                    <TextBlock Grid.Column="3"
                                               Text="›"
                                               FontSize="28"
                                               Foreground="#2589D5"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>



    </Border>


</UserControl>
