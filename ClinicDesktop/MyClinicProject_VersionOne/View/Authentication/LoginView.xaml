<Window x:Class="MyClinicProject_VersionOne.View.Authentication.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyClinicProject_VersionOne.View.Authentication"
        xmlns:helpers="clr-namespace:MyClinicProject_VersionOne.Helpers"
        mc:Ignorable="d"
        Title="LoginView" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
           FlowDirection="RightToLeft">
    <Border Background="#FFB4D7FA" CornerRadius="8" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =================== العمود الأيمن (الصورة والترحيب) =================== -->
            <Border Grid.Column="0" Style="{StaticResource MainBorderStyle}" Padding="0" CornerRadius="8,0,0,8" ClipToBounds="True">
                <Grid>
                    <Image Source="/Styles/Images/Login.png" Stretch="UniformToFill" />

                    <!-- تدرج لوني أزرق طبي فوق الصورة -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC1E3A8A" Offset="0.0"/>
                                <GradientStop Color="#CC3B82F6" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <TextBlock Text="Smart Clinic"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                        <TextBlock Text="نظام متكامل لإدارة العيادات بكفاءة وسهولة عالية"
                               Foreground="#E0F2FE"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- فاصل وسطي رفيع -->
            <Rectangle Grid.Column="1" Fill="#CBD5E1" Margin="0,20"/>

            <!-- =================== العمود الأيسر (حقول الإدخال) =================== -->
            <Border Grid.Column="2" Style="{StaticResource MainBorderStyle}" Padding="35" CornerRadius="0,8,8,0">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">

                    <!-- نصوص الترحيب والعنوان -->
                    <TextBlock Text="تسجيل الدخول"
                           Foreground="#1A3F8A"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="أدخل بيانات حسابك للوصول إلى لوحة التحكم"
                           Style="{StaticResource TextSecond}"
                           Margin="0,5,0,25"
                           HorizontalAlignment="Center"/>

                    <!-- ================= 1. حقل اسم المستخدم ================= -->
                    <TextBlock Text="اسم المستخدم"
                           Style="{StaticResource CardHeaderStyle}"
                           Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- أيقونة المستخدم 👤 -->
                        <TextBlock Grid.Column="0" 
                               Text="👤" 
                               FontSize="18" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               Foreground="#1E6DFF"/>

                        <TextBox Grid.Column="1"
                             x:Name="TxtUsername"
                             Style="{StaticResource TextBoxStyle}"
                             helpers:InputHelper.IsUsernameOnly="True"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </Grid>
                    <!-- رسالة الخطأ الخاصة باسم المستخدم -->
                    <TextBlock Text="{Binding ElementName=TxtUsername, Path=(Validation.Errors)/ErrorContent}"
                           Foreground="#DC2626" FontSize="11" Margin="35,0,0,10"/>


                    <!-- ================= 2. حقل كلمة المرور ================= -->
                    <TextBlock Text="كلمة المرور"
                           Style="{StaticResource CardHeaderStyle}"
                           Margin="0,5,0,5"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- أيقونة القفل 🔒 -->
                        <TextBlock Grid.Column="0" 
                               Text="🔒" 
                               FontSize="18" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               Foreground="#1E6DFF"/>

                        <!-- تم تصحيح Grid.Column إلى 1 وإضافة ربط PasswordHelper -->
                        <PasswordBox Grid.Column="1"
                                 x:Name="PbPassword"
                                 Style="{StaticResource PasswordBoxStyle}"
                                 helpers:PasswordHelper.Attach="True"
                                 helpers:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </Grid>
                    <!-- رسالة الخطأ الخاصة بكلمة المرور -->
                    <TextBlock Text="{Binding ElementName=PbPassword, Path=(Validation.Errors)/ErrorContent}"
                           Foreground="#DC2626" FontSize="11" Margin="35,0,0,10"/>


                    <!-- خيارات: نسيت كلمة المرور وتذكرني -->
                    <Grid Margin="0,5,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" HorizontalAlignment="Left">
                        <Hyperlink x:Name="ForgotPassword" Foreground="#1E6DFF" TextDecorations="{x:Null}">
                            نسيت كلمة المرور؟
                        </Hyperlink>
                        </TextBlock>

                        <CheckBox Grid.Column="1" 
                              Content="تذكرني"
                              HorizontalAlignment="Right" 
                              Foreground="#64748B"/>
                    </Grid>

                    <!-- رسالة خطأ الخادم القادمة من FastAPI (تظهر باللون الأحمر عند فشل الدخول) -->
                    <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                    <!-- ================= 3. زر تسجيل الدخول ================= -->
                    <!-- تم تحويله إلى Button وإضافة خاصية IsDefault للضغط بالـ Enter -->
                    <Button x:Name="LoginButton"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="42"
                        Background="#1E6DFF"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="تسجيل الدخول"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Content" Value="جاري تسجيل الدخول..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>