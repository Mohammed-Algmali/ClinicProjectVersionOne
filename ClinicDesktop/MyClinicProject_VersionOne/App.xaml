<Application x:Class="MyClinicProject_VersionOne.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyClinicProject_VersionOne"
             xmlns:views="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.FacilitiesManagement.Facility"
             xmlns:vms="clr-namespace:MyClinicProject_VersionOne.ViewModel.PlatformAdmin.FacilitiesManagement.Facility"
              xmlns:teamview="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.UserAndPermissions.PlatformTeam"
             xmlns:teamvms="clr-namespace:MyClinicProject_VersionOne.ViewModel.PlatformAdmin.UserAndPermissions.PlatformTeam"
             xmlns:roleview="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.UserAndPermissions.RoleAndPermissios"
             xmlns:rolevms="clr-namespace:MyClinicProject_VersionOne.ViewModel.PlatformAdmin.UserAndPermissions.RoleAndPermissios"
              xmlns:planview="clr-namespace:MyClinicProject_VersionOne.View.PlatformAdmin.SubscriptionsAndFinance.Plan"
             xmlns:planvms="clr-namespace:MyClinicProject_VersionOne.ViewModel.PlatformAdmin.SubscriptionsAndFinance.Plan"
             xmlns:employeeview="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources"
             xmlns:employeevms="clr-namespace:MyClinicProject_VersionOne.ViewModel.HealthCareSystem.HumanResources"
             xmlns:attendanceview="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources.Attendance"
             xmlns:attendancevms="clr-namespace:MyClinicProject_VersionOne.ViewModel.HealthCareSystem.HumanResources.Attendance"
             xmlns:operationauditview="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.OperationAudit"
             xmlns:operationauditvms="clr-namespace:MyClinicProject_VersionOne.ViewModel.HealthCareSystem.OperationAudit"
             
             xmlns:jobview="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources.Job"
             xmlns:jobvms="clr-namespace:MyClinicProject_VersionOne.ViewModel.HealthCareSystem.HumanResources.Job"
             
              xmlns:shiftview="clr-namespace:MyClinicProject_VersionOne.View.HealthCareSystem.HumanResources.Shifts"
             xmlns:shiftvms="clr-namespace:MyClinicProject_VersionOne.ViewModel.HealthCareSystem.HumanResources.Shift"
             
             
             StartupUri="View/Authentication/LoginView.xaml">
    <!--StartupUri="View/Authentication/LoginView.xaml"-->
    <Application.Resources>
        <ResourceDictionary>
            
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Styles/TextBlockStyles.xaml"/>
                <ResourceDictionary Source="/Styles/UIColors.xaml"/>
                
                <!--التنسيقات الجديده-->
                <ResourceDictionary Source="/Styles/Style/CardStyles.xaml"/>
                <ResourceDictionary Source="/Styles/Style/TextBlockStyle.xaml"/>
                <ResourceDictionary Source="/Styles/Style/TextBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/Style/ComboBoxStyles.xaml"/>

            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="CairFont">/MyClinicProject_VersionOne;component/Styles/#Cairo</FontFamily>
            <DataTemplate DataType="{x:Type vms:FacilityListViewModel}">
                <views:FacilityListView/>
            </DataTemplate>


            <DataTemplate DataType="{x:Type teamvms:PlatformTeamListViewModel}">
                <teamview:PlatformTeamListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type planvms:PlanListViewModel}">
                <planview:PlanListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type rolevms:RoleListViewModel}">
                <roleview:RoleListView/>
            </DataTemplate>


            <DataTemplate DataType="{x:Type employeevms:EmployeeListViewModel}">
                <employeeview:EmployeeListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type attendancevms:AttendanceListViewModel}">
                <attendanceview:AttendanceListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type operationauditvms:AuditLogViewModel}">
                <operationauditview:AuditLogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type jobvms:JobListViewModel}">
                <jobview:JobListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type shiftvms:ShiftListViewModel}">
                <shiftview:ShiftListView/>
            </DataTemplate>


        </ResourceDictionary>
      
    </Application.Resources>
</Application>
