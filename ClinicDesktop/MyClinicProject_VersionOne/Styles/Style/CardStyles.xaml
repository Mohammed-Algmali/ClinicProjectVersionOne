<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 
    ===================================================================
    [STATISTIC CARD TEMPLATE] - قالب بطاقات الإحصائيات الموحد للتطبيق
    ===================================================================
-->
    <Style x:Key="StatisticCardStyle" TargetType="HeaderedContentControl">
        <Setter Property="Background" Value="{DynamicResource StatCardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BackgroundMenu}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Margin" Value="0,0,5,0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="12" 
                        Padding="{TemplateBinding Padding}">

                        <!-- تأثير الظل الخفيف لجعل البطاقة عصرية ومرفوعة -->
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Opacity="0.04" Color="#0F172A"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- النصوص (يمين) -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- الأيقونة (يسار) -->
                            </Grid.ColumnDefinitions>

                            <!-- قسم النصوص: العنوان والإحصائية رقمياً -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- العنوان الفرعي (Header) -->
                                <ContentPresenter Content="{TemplateBinding Header}" 
                                              TextBlock.FontSize="13" 
                                              TextBlock.Foreground="{DynamicResource SidebarActiveBg}" 
                                              TextBlock.FontWeight="Medium" 
                                              Margin="0,0,0,4"/>

                                <!-- الرقم الإحصائي الرئيسي (Content) -->
                                <ContentPresenter Content="{TemplateBinding Content}" 
                                              TextBlock.FontSize="26" 
                                              TextBlock.Foreground="White" 
                                              TextBlock.FontWeight="Bold"/>
                            </StackPanel>

                            <!-- قسم الأيقونة الدائرية على اليسار (مخزنة في الـ Tag) -->
                            <Border Grid.Column="1" 
                                Background="#F1F5F9" 
                                Width="46" 
                                Height="46" 
                                CornerRadius="23" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Right">

                                <ContentPresenter Content="{TemplateBinding Tag}"
                                              TextBlock.FontSize="20" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!---->
    
 
   

    



</ResourceDictionary>