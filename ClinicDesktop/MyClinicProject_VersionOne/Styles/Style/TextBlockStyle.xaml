<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--الاستخدام: لتسميات الحقول التي توضع فوق خانات الادخال مثل:اسم المسنخدم-->
    <Style x:Key="FiledLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Background" Value="Transparent"/>

    </Style>


    <!--الاستخدام لعناوين الكروت والقسام الداخليه مثل المعلومات الاساسيه-->
    <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#0066FF"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>



</ResourceDictionary>