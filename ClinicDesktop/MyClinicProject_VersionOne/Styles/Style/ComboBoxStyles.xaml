<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--تنسيقات ComboBox-->

    <!-- التنسيق الرئيسي للـ ComboBox -->
    <Style x:Key="ModernComboBoxStyle"
           TargetType="ComboBox">

        <!-- جعل الخط أسمك قليلاً داخل القائمة المنسدلة فقط -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </Setter.Value>
        </Setter>

        <!-- ارتفاع الحقل -->
        <Setter Property="Height" Value="38"/>

        <!-- لون خلفية الحقل -->
        <Setter Property="Background" Value="White"/>

        <!-- لون الحدود -->
        <Setter Property="BorderBrush" Value="#D9E3EE"/>

        <!-- سماكة الحدود -->
        <Setter Property="BorderThickness" Value="1"/>

        <!-- لون النص -->
        <Setter Property="Foreground" Value="#0B132B"/>

        <!-- حجم الخط -->
        <Setter Property="FontSize" Value="13"/>

        <!-- اتجاه النص العربي -->
        <Setter Property="FlowDirection" Value="RightToLeft"/>

        <!-- إظهار علامة اليد عند مرور الماوس -->
        <Setter Property="Cursor" Value="Hand"/>
        <!-- تحديد التصميم الداخلي للـ ComboBox -->
        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="ComboBox">

                    <!-- الحاوية الأساسية للتصميم -->
                    <Grid>

                        <!-- الإطار الخارجي للحقل -->
                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <!-- زر يغطي كامل الحقل -->
                            <ToggleButton
                                x:Name="ComboToggleButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen,
                                            Mode=TwoWay,
                                            RelativeSource={RelativeSource TemplatedParent}}">

                                <!-- إزالة الشكل الافتراضي للزر -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border Background="Transparent">
                                            <ContentPresenter
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"/>
                                        </Border>

                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <!-- تقسيم الحقل إلى منطقتين -->
                                <Grid FlowDirection="LeftToRight"
                                      Background="Transparent">

                                    <Grid.ColumnDefinitions>

                                        <!-- العمود الأيسر للسهم -->
                                        <ColumnDefinition Width="34"/>

                                        <!-- العمود الأيمن للنص -->
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <!-- عرض العنصر المختار -->
                                    <ContentPresenter
                                        x:Name="SelectedContent"
                                        Grid.Column="1"
                                        FlowDirection="RightToLeft"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Margin="10,0,10,0"
                                        IsHitTestVisible="False"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                    <!-- السهم في الجهة اليسرى -->
                                    <Path
                                        x:Name="ComboArrow"
                                        Grid.Column="0"
                                        Data="M 0 0 L 5 5 L 10 0"
                                        Stroke="#64748B"
                                        StrokeThickness="1.8"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Stretch="None"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>

                                </Grid>


                            </ToggleButton>

                        </Border>

                        <!-- القائمة المنسدلة التي تعرض الخيارات -->
                        <Popup
                            x:Name="PART_Popup"
                            Placement="Bottom"
                            AllowsTransparency="True"
                            PopupAnimation="Fade"
                            IsOpen="{Binding IsDropDownOpen,
                                     RelativeSource={RelativeSource TemplatedParent}}">

                            <!-- الإطار الخارجي للقائمة -->
                            <Border
                                Background="White"
                                BorderBrush="#D9E3EE"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4"
                                MinWidth="{Binding ActualWidth,
                                           RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                <!-- السماح بالتمرير عند كثرة الخيارات -->
                                <ScrollViewer
                                    FlowDirection="RightToLeft"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    CanContentScroll="True">

                                    <!-- عرض عناصر ComboBox الموجودة في الواجهة -->
                                    <ItemsPresenter/>

                                </ScrollViewer>

                            </Border>

                        </Popup>

                    </Grid>


                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>







</ResourceDictionary>