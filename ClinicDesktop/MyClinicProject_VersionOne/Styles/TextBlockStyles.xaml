<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
    <!-- PrimaryTitle Page-->
    <!-- تنسيق العنوان الرئيسي في الصفحه مثل العناوين العريضه-->
    <Style x:Key="PrimaryTextTitleadd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource CairFont}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- تنسيق العنوان الفرعي في الصفحه  نص اصغر ولون رمادي خفيف لبيان الوصف-->
    <Style x:Key="SecondaryTextTitlePage" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource CairFont}"/>
        <Setter Property="Foreground" Value="Gray"/>
        <Setter Property="Margin" Value="5,7,0,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <!-- عنوان الأقسام في الواجهات -->
    <!-- تنسيق مخصص لعناوين الاقسام الفرعيهداخل النموذج او الاستمارة -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource CairFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <!-- يستخدم للمسميات العاديه داخل النموذج و النصوص الفرعيه المساعده-->
    <Style x:Key="TextSecond" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource CairFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#FF0B57A3"/>
        <Setter Property="Margin" Value="5,10,0,0"/>
    </Style>





   
</ResourceDictionary>